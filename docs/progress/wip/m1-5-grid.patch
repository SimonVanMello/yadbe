diff --git a/src/features/grid/CellViewer.tsx b/src/features/grid/CellViewer.tsx
new file mode 100644
index 0000000..e6e2e60
--- /dev/null
+++ b/src/features/grid/CellViewer.tsx
@@ -0,0 +1,271 @@
+import { useQuery } from '@tanstack/react-query';
+import { useMemo, useState } from 'react';
+
+import { showError } from '../../app/errors/presentError';
+import { useI18nStore } from '../../i18n/i18n';
+import { useT } from '../../i18n/useT';
+import { fileSaver } from '../../ipc/saveFile';
+import { IconButton } from '../../ui/IconButton';
+import { SegmentedControl } from '../../ui/SegmentedControl';
+import { Spinner } from '../../ui/Spinner';
+import { toast } from '../../ui/toastStore';
+import styles from './CellViewer.module.css';
+import { writeClipboard } from './clipboard';
+import { formatCount } from './formatCount';
+import { JsonView, type Openness } from './JsonView';
+import {
+  analyzeValue,
+  extensionFor,
+  HEX_DUMP_BYTES,
+  hexDump,
+  hexToBytes,
+  TEXT_VIEW_CHARS,
+  type ViewerMode,
+} from './prettyValue';
+import type { RowSource } from './rowSource';
+import { useDebouncedValue } from './useDebouncedValue';
+import { XmlView } from './XmlView';
+
+interface CellViewerProps {
+  source: RowSource;
+  /** Identifies the source in the query cache (a result id). */
+  sourceKey: string;
+  /** The focused cell (data column), `null` without one. */
+  target: { row: number; col: number } | null;
+  onClose: () => void;
+}
+
+const SETTLE_MS = 80;
+
+/** Side panel showing the focused cell's whole value (F-064). */
+export function CellViewer({ source, sourceKey, target, onClose }: CellViewerProps) {
+  const t = useT();
+  const locale = useI18nStore((state) => state.locale);
+  const key = useDebouncedValue(
+    target ? `${String(target.row)}:${String(target.col)}` : null,
+    SETTLE_MS,
+  );
+  const [row, col] = key === null ? [null, null] : key.split(':').map(Number);
+  const valid = row != null && col != null;
+  const query = useQuery({
+    queryKey: ['grid-cell', sourceKey, row, col],
+    queryFn: () => (valid ? source.fullValue(row, col) : Promise.reject(new Error('no cell'))),
+    enabled: valid,
+    staleTime: Infinity,
+    gcTime: 60_000,
+  });
+  const analysis = useMemo(() => (query.data ? analyzeValue(query.data) : null), [query.data]);
+  const [modeChoice, setModeChoice] = useState<ViewerMode | null>(null);
+  const [wrap, setWrap] = useState(true);
+  const [fold, setFold] = useState<{ openness: Openness; seq: number }>({
+    openness: 'auto',
+    seq: 0,
+  });
+  const number = new Intl.NumberFormat(locale);
+
+  const column = valid ? source.columns[col] : undefined;
+  const mode: ViewerMode =
+    analysis && modeChoice && analysis.modes.includes(modeChoice)
+      ? modeChoice
+      : (analysis?.preferred ?? 'text');
+  const isBinary = query.data?.kind === 'bytes';
+  const text = analysis?.text ?? '';
+
+  const copy = () => {
+    writeClipboard(text).then(
+      () => toast({ variant: 'success', title: t('grid.viewer.copied'), duration: 2000 }),
+      (error: unknown) => {
+        showError(error, { title: t('grid.copy.failed') });
+      },
+    );
+  };
+
+  const save = () => {
+    if (!analysis || !column || row === null) return;
+    const extension = isBinary ? 'bin' : extensionFor(mode);
+    const filterName = {
+      bin: t('grid.viewer.filter.binary'),
+      json: t('grid.viewer.filter.json'),
+      xml: t('grid.viewer.filter.xml'),
+      txt: t('grid.viewer.filter.text'),
+    }[extension];
+    const safeName = column.name.replace(/[^\w.-]+/g, '_') || 'value';
+    fileSaver
+      .save({
+        title: t('grid.viewer.saveTitle'),
+        defaultName: `${safeName}-${String(row + 1)}.${extension}`,
+        filters: [
+          { name: filterName ?? t('grid.viewer.filter.all'), extensions: [extension] },
+          { name: t('grid.viewer.filter.all'), extensions: ['*'] },
+        ],
+        contents: isBinary ? hexToBytes(text) : text,
+      })
+      .then(
+        (path) => {
+          if (path) toast({ variant: 'success', title: t('grid.viewer.saved', { path }) });
+        },
+        (error: unknown) => {
+          showError(error, { title: t('grid.viewer.saveFailed') });
+        },
+      );
+  };
+
+  const size = isBinary
+    ? formatCount(locale, 'grid.viewer.bytes', text.length / 2)
+    : formatCount(locale, 'grid.viewer.chars', text.length);
+
+  let body;
+  if (!valid || !column) {
+    body = <p className={styles.notice}>{t('grid.viewer.none')}</p>;
+  } else if (query.isPending) {
+    body = (
+      <p className={styles.notice} role="status">
+        <Spinner />
+        {t('grid.viewer.loading')}
+      </p>
+    );
+  } else if (query.isError) {
+    body = (
+      <p className={styles.notice} role="alert">
+        {t('grid.viewer.failed')}
+      </p>
+    );
+  } else if (!analysis) {
+    body = <p className={styles.notice}>{t('grid.viewer.isNull')}</p>;
+  } else if (text === '') {
+    body = <p className={styles.notice}>{t('grid.viewer.isEmpty')}</p>;
+  } else if (mode === 'json' && analysis.json) {
+    body = (
+      <JsonView
+        key={`${key ?? ''}:${String(fold.seq)}`}
+        tree={analysis.json}
+        openness={fold.openness}
+      />
+    );
+  } else if (mode === 'xml' && analysis.xml) {
+    body = (
+      <XmlView
+        key={`${key ?? ''}:${String(fold.seq)}`}
+        nodes={analysis.xml}
+        openness={fold.openness}
+      />
+    );
+  } else if (mode === 'hex') {
+    const total = text.length / 2;
+    body = (
+      <>
+        {total > HEX_DUMP_BYTES && (
+          <p className={styles.limit}>
+            {t('grid.viewer.hexLimit', {
+              shown: number.format(HEX_DUMP_BYTES),
+              total: number.format(total),
+            })}
+          </p>
+        )}
+        <pre className={styles.pre}>{hexDump(text).join('\n')}</pre>
+      </>
+    );
+  } else {
+    body = (
+      <>
+        {analysis.jsonError && (
+          <p className={styles.limit}>
+            {t('grid.viewer.invalidJson', { message: analysis.jsonError })}
+          </p>
+        )}
+        {text.length > TEXT_VIEW_CHARS && (
+          <p className={styles.limit}>
+            {t('grid.viewer.textLimit', {
+              shown: number.format(TEXT_VIEW_CHARS),
+              total: number.format(text.length),
+            })}
+          </p>
+        )}
+        <pre className={[styles.pre, wrap ? styles.wrap : ''].filter(Boolean).join(' ')}>
+          {text.length > TEXT_VIEW_CHARS ? text.slice(0, TEXT_VIEW_CHARS) : text}
+        </pre>
+      </>
+    );
+  }
+
+  const ready = !!analysis && text !== '';
+  const foldable =
+    ready && ((mode === 'json' && !!analysis.json) || (mode === 'xml' && !!analysis.xml));
+
+  return (
+    <aside className={styles.viewer} aria-label={t('grid.viewer.title')}>
+      <header className={styles.header}>
+        <div className={styles.title}>
+          <span className={styles.name}>{column?.name ?? t('grid.viewer.title')}</span>
+          {column?.typeName && <span className={styles.meta}>{column.typeName}</span>}
+          {valid && (
+            <span className={styles.meta}>
+              {t('grid.viewer.position', { row: number.format(row + 1) })}
+            </span>
+          )}
+        </div>
+        <IconButton
+          icon="copy"
+          size="sm"
+          label={t('grid.viewer.copy')}
+          disabled={!ready}
+          onClick={copy}
+        />
+        <IconButton
+          icon="file"
+          size="sm"
+          label={fileSaver.available ? t('grid.viewer.save') : t('grid.viewer.saveUnavailable')}
+          disabled={!ready || !fileSaver.available}
+          onClick={save}
+        />
+        <IconButton icon="close" size="sm" label={t('grid.viewer.hide')} onClick={onClose} />
+      </header>
+      {ready && (
+        <div className={styles.toolbar}>
+          {analysis.modes.length > 1 && (
+            <SegmentedControl<ViewerMode>
+              label={t('grid.viewer.mode')}
+              value={mode}
+              options={analysis.modes.map((m) => ({ value: m, label: t(`grid.viewer.mode.${m}`) }))}
+              onChange={setModeChoice}
+            />
+          )}
+          <span className={styles.size}>{size}</span>
+          <span className={styles.spacer} />
+          {mode === 'text' && (
+            <IconButton
+              icon="list"
+              size="sm"
+              label={t('grid.viewer.wrap')}
+              aria-pressed={wrap}
+              onClick={() => {
+                setWrap((w) => !w);
+              }}
+            />
+          )}
+          {foldable && (
+            <>
+              <IconButton
+                icon="chevronDown"
+                size="sm"
+                label={t('grid.viewer.expandAll')}
+                onClick={() => {
+                  setFold((f) => ({ openness: 'all', seq: f.seq + 1 }));
+                }}
+              />
+              <IconButton
+                icon="chevronUp"
+                size="sm"
+                label={t('grid.viewer.collapseAll')}
+                onClick={() => {
+                  setFold((f) => ({ openness: 'none', seq: f.seq + 1 }));
+                }}
+              />
+            </>
+          )}
+        </div>
+      )}
+      <div className={styles.body}>{body}</div>
+    </aside>
+  );
+}
diff --git a/src/features/grid/DataGrid.module.css b/src/features/grid/DataGrid.module.css
new file mode 100644
index 0000000..538e49c
--- /dev/null
+++ b/src/features/grid/DataGrid.module.css
@@ -0,0 +1,317 @@
+.grid {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  min-height: 0;
+  background: var(--bg-panel);
+}
+
+.main {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+}
+
+/* The scroll container is the ARIA grid: it holds the focus and the keyboard. */
+.scroller {
+  position: relative;
+  flex: 1;
+  min-width: 0;
+  overflow: auto;
+  outline: none;
+  background: var(--bg-panel);
+  color: var(--fg-primary);
+  font-family: var(--font-code);
+  font-size: var(--text-sm);
+  overscroll-behavior: contain;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+/* Sized inline (never by its content: intrinsic sizing would lay out every row). */
+.sizer {
+  position: relative;
+  min-width: 100%;
+}
+
+.header {
+  position: sticky;
+  top: 0;
+  z-index: 3;
+  height: var(--grid-header-height);
+  min-width: 100%;
+  border-bottom: var(--border-width) solid var(--border-strong);
+  background: var(--bg-elevated);
+}
+
+.corner {
+  position: sticky;
+  left: 0;
+  z-index: 2;
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  height: 100%;
+  padding: 0 var(--grid-cell-padding-x);
+  border-right: var(--border-width) solid var(--border-strong);
+  background: var(--bg-elevated);
+  color: var(--fg-muted);
+  font-family: var(--font-ui);
+  font-size: var(--text-xs);
+  cursor: default;
+}
+
+.headerCell {
+  position: absolute;
+  top: 0;
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  height: 100%;
+  padding: 0 var(--grid-cell-padding-x);
+  overflow: hidden;
+  border-right: var(--border-width) solid var(--border-subtle);
+  color: var(--fg-primary);
+  font-family: var(--font-ui);
+  font-size: var(--text-sm);
+  white-space: nowrap;
+  cursor: default;
+}
+
+.headerCell:hover {
+  background: var(--bg-hover);
+}
+
+.headerName {
+  min-width: 0;
+  overflow: hidden;
+  font-weight: var(--weight-semibold);
+  text-overflow: ellipsis;
+}
+
+.headerType {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  color: var(--fg-muted);
+  font-size: var(--text-2xs);
+  text-overflow: ellipsis;
+}
+
+.headerSelected,
+.headerSelected:hover {
+  background: var(--grid-selection-header-bg);
+}
+
+.headerTouched {
+  box-shadow: inset 0 calc(-1 * var(--focus-ring-width)) 0 var(--accent);
+}
+
+.headerDragging {
+  opacity: 0.6;
+}
+
+.resizeHandle {
+  position: absolute;
+  top: 0;
+  right: 0;
+  z-index: 1;
+  width: var(--grid-resize-handle-width);
+  height: 100%;
+  cursor: col-resize;
+}
+
+.resizeHandle:hover {
+  background: var(--accent-soft);
+}
+
+.dropIndicator {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  z-index: 4;
+  width: var(--focus-ring-width);
+  margin-left: calc(var(--focus-ring-width) / -2);
+  background: var(--accent);
+  pointer-events: none;
+}
+
+/* Rows are created and placed by gridBody.ts; `--gutter` is set inline. */
+.body {
+  --gutter: var(--grid-gutter-min-width);
+  position: relative;
+}
+
+/* The row numbers: one layer stuck to the left edge, its cells placed like the rows. */
+.gutters {
+  position: sticky;
+  left: 0;
+  z-index: 2;
+  width: var(--gutter);
+  height: 100%;
+  border-right: var(--border-width) solid var(--border-strong);
+  background: var(--bg-elevated);
+  contain: strict;
+}
+
+.rows {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+}
+
+.row {
+  position: absolute;
+  top: 0;
+  left: 0;
+  height: var(--grid-row-height);
+  border-bottom: var(--border-width) solid var(--border-subtle);
+  /* Each row and cell is its own layout and paint island: new text relayouts only itself. */
+  contain: strict;
+}
+
+.gutterCell {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: var(--grid-row-height);
+  padding: 0 var(--grid-cell-padding-x);
+  border-bottom: var(--border-width) solid var(--border-subtle);
+  color: var(--fg-muted);
+  font-size: var(--text-xs);
+  line-height: calc(var(--grid-row-height) - var(--border-width));
+  text-align: right;
+  contain: strict;
+}
+
+.gutterCell[data-touched] {
+  background: var(--grid-selection-header-bg);
+  color: var(--fg-secondary);
+}
+
+.cell {
+  position: absolute;
+  top: 0;
+  height: 100%;
+  contain: strict;
+  padding: 0 var(--grid-cell-padding-x);
+  overflow: hidden;
+  border-right: var(--border-width) solid var(--border-subtle);
+  line-height: calc(var(--grid-row-height) - var(--border-width));
+  text-overflow: ellipsis;
+  white-space: pre;
+}
+
+.cell[aria-selected='true'] {
+  background: var(--grid-selection-bg);
+}
+
+.cell[data-focused] {
+  box-shadow: inset 0 0 0 var(--focus-ring-width) var(--border-strong);
+}
+
+.scroller:focus .cell[data-focused] {
+  box-shadow: inset 0 0 0 var(--focus-ring-width) var(--accent);
+}
+
+/* A cut value (more in the backend): a corner mark, the viewer shows it whole. */
+.cell[data-truncated]::after {
+  content: '';
+  position: absolute;
+  top: 0;
+  right: 0;
+  border-style: solid;
+  border-width: 0 var(--grid-truncated-marker-size) var(--grid-truncated-marker-size) 0;
+  border-color: transparent var(--warning) transparent transparent;
+}
+
+.num {
+  text-align: right;
+}
+
+/* NULL, the empty string and invisible whitespace each read differently from text. */
+.null {
+  color: var(--cell-null);
+  font-size: var(--text-xs);
+  font-style: italic;
+  letter-spacing: var(--tracking-caps);
+}
+
+.empty {
+  color: var(--fg-muted);
+  font-family: var(--font-ui);
+  font-size: var(--text-xs);
+  font-style: italic;
+}
+
+.mark {
+  color: var(--fg-muted);
+}
+
+/* Rows whose window is still loading. */
+.row[data-loading]::after {
+  content: '';
+  position: absolute;
+  top: var(--space-2);
+  bottom: var(--space-2);
+  left: calc(var(--gutter) + var(--grid-cell-padding-x));
+  right: var(--grid-cell-padding-x);
+  border-radius: var(--radius-sm);
+  background: var(--bg-hover);
+  animation: shimmer var(--grid-shimmer-duration) ease-in-out infinite;
+}
+
+@keyframes shimmer {
+  50% {
+    opacity: 0.4;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .row[data-loading]::after {
+    animation: none;
+  }
+}
+
+.emptyRows {
+  position: absolute;
+  top: var(--grid-header-height);
+  left: 0;
+  right: 0;
+  padding: var(--space-6);
+  color: var(--fg-muted);
+  font-family: var(--font-ui);
+  font-size: var(--text-md);
+  text-align: center;
+  pointer-events: none;
+}
+
+.footer {
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  flex: none;
+  height: var(--grid-footer-height);
+  padding: 0 var(--space-1) 0 var(--space-4);
+  border-top: var(--border-width) solid var(--border-subtle);
+  background: var(--bg-elevated);
+  color: var(--fg-secondary);
+  font-size: var(--text-xs);
+}
+
+.footerStart {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  flex: 1;
+  min-width: 0;
+  white-space: nowrap;
+}
+
+.selectionInfo {
+  color: var(--fg-muted);
+  white-space: nowrap;
+}
