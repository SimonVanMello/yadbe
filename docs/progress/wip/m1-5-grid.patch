+import { platform } from '../../ui/platform';
+import type { SelectMode } from './selection';
+
+type Modifiers = Pick<MouseEvent, 'shiftKey' | 'metaKey' | 'ctrlKey'>;
+
+/** ⌘ on macOS, Ctrl elsewhere (the `Mod` of shortcuts). */
+export function modKey(event: Modifiers): boolean {
+  return platform === 'mac' ? event.metaKey : event.ctrlKey;
+}
+
+/** Shift extends the selection, Mod adds to it, a plain click replaces it. */
+export function selectModeOf(event: Modifiers): SelectMode {
+  if (event.shiftKey) return 'extend';
+  return modKey(event) ? 'add' : 'replace';
+}
diff --git a/src/features/grid/prettyValue.ts b/src/features/grid/prettyValue.ts
new file mode 100644
index 0000000..84814d7
--- /dev/null
+++ b/src/features/grid/prettyValue.ts
@@ -0,0 +1,174 @@
+import type { Value } from '../../ipc';
+import { parseJson, tryParseJson, type JsonNode } from './jsonTree';
+
+/** Display modes of the cell viewer (F-064). */
+export type ViewerMode = 'text' | 'json' | 'xml' | 'hex';
+
+/** Bytes a hex dump shows at most (the rest is announced, and stays copyable / savable). */
+export const HEX_DUMP_BYTES = 64 * 1024;
+/** Characters the text view shows at most. */
+export const TEXT_VIEW_CHARS = 500_000;
+
+/** Lines of a classic hex dump: offset, 16 bytes in two groups, printable ASCII. */
+export function hexDump(hex: string, maxBytes = HEX_DUMP_BYTES): string[] {
+  const total = Math.floor(hex.length / 2);
+  const count = Math.min(total, maxBytes);
+  const lines: string[] = [];
+  for (let start = 0; start < count; start += 16) {
+    const end = Math.min(count, start + 16);
+    let bytes = '';
+    let ascii = '';
+    for (let i = start; i < start + 16; i++) {
+      if (i === start + 8) bytes += ' ';
+      if (i < end) {
+        const pair = hex.slice(i * 2, i * 2 + 2);
+        const code = parseInt(pair, 16);
+        bytes += `${pair} `;
+        ascii += code >= 0x20 && code < 0x7f ? String.fromCharCode(code) : '.';
+      } else {
+        bytes += '   ';
+      }
+    }
+    lines.push(`${start.toString(16).padStart(8, '0')}  ${bytes} |${ascii}|`);
+  }
+  return lines;
+}
+
+export function hexToBytes(hex: string): Uint8Array {
+  const bytes = new Uint8Array(Math.floor(hex.length / 2));
+  for (let i = 0; i < bytes.length; i++) bytes[i] = parseInt(hex.slice(i * 2, i * 2 + 2), 16);
+  return bytes;
+}
+
+export type XmlNode =
+  | { type: 'element'; name: string; attributes: [string, string][]; children: XmlNode[] }
+  | { type: 'text'; text: string }
+  | { type: 'comment'; text: string }
+  | { type: 'cdata'; text: string }
+  | { type: 'instruction'; target: string; text: string };
+
+const MAX_XML_NODES = 20_000;
+
+/** The document's nodes (whitespace-only text dropped), or `null` when not well-formed XML. */
+export function parseXml(text: string): XmlNode[] | null {
+  if (!/^\s*</.test(text)) return null;
+  const doc = new DOMParser().parseFromString(text, 'application/xml');
+  if (doc.getElementsByTagName('parsererror').length > 0) return null;
+  let budget = MAX_XML_NODES;
+  const convert = (node: Node): XmlNode | null => {
+    if (budget-- <= 0) return null;
+    switch (node.nodeType) {
+      case Node.ELEMENT_NODE: {
+        const el = node as Element;
+        return {
+          type: 'element',
+          name: el.tagName,
+          attributes: [...el.attributes].map((a) => [a.name, a.value]),
+          children: [...el.childNodes].flatMap((child) => convert(child) ?? []),
+        };
+      }
+      case Node.TEXT_NODE: {
+        const value = node.nodeValue ?? '';
+        return value.trim() ? { type: 'text', text: value.trim() } : null;
+      }
+      case Node.CDATA_SECTION_NODE:
+        return { type: 'cdata', text: node.nodeValue ?? '' };
+      case Node.COMMENT_NODE:
+        return { type: 'comment', text: (node.nodeValue ?? '').trim() };
+      case Node.PROCESSING_INSTRUCTION_NODE: {
+        const pi = node as ProcessingInstruction;
+        return { type: 'instruction', target: pi.target, text: pi.data };
+      }
+      default:
+        return null;
+    }
+  };
+  return [...doc.childNodes].flatMap((node) => convert(node) ?? []);
+}
+
+export interface Analysis {
+  /** The value as text (hex for binary), what Copy puts on the clipboard. */
+  text: string;
+  modes: ViewerMode[];
+  /** The mode shown first. */
+  preferred: ViewerMode;
+  json: JsonNode | null;
+  /** Why a JSON column's value could not be read as JSON. */
+  jsonError: string | null;
+  xml: XmlNode[] | null;
+}
+
+/** What the viewer can show for a value. `null` for SQL NULL. */
+export function analyzeValue(value: Value): Analysis | null {
+  if (value.kind === 'null') return null;
+  if (value.kind === 'bytes') {
+    return {
+      text: value.value,
+      modes: ['hex', 'text'],
+      preferred: 'hex',
+      json: null,
+      jsonError: null,
+      xml: null,
+    };
+  }
+  const text =
+    value.kind === 'bool'
+      ? String(value.value)
+      : value.kind === 'array'
+        ? JSON.stringify(value.value)
+        : value.value;
+  let json: JsonNode | null = null;
+  let jsonError: string | null = null;
+  const trimmed = text.trimStart();
+  if (value.kind === 'json' || value.kind === 'array' || /^[[{]/.test(trimmed)) {
+    try {
+      json = value.kind === 'array' ? arrayTree(value.value) : parseJson(text);
+    } catch (error) {
+      if (value.kind === 'json') jsonError = error instanceof Error ? error.message : String(error);
+    }
+  }
+  const xml = !json && trimmed.startsWith('<') ? parseXml(text) : null;
+  const modes: ViewerMode[] = ['text'];
+  if (json) modes.unshift('json');
+  if (xml) modes.unshift('xml');
+  return { text, modes, preferred: modes[0] ?? 'text', json, jsonError, xml };
+}
+
+/** An array value as JSON: its elements in their JSON form (numbers kept exact). */
+function arrayTree(values: Value[]): JsonNode {
+  const node = (v: Value): JsonNode => {
+    switch (v.kind) {
+      case 'null':
+        return { type: 'null' };
+      case 'bool':
+        return { type: 'bool', value: v.value };
+      case 'array':
+        return { type: 'array', items: v.value.map(node) };
+      case 'int':
+      case 'decimal':
+      case 'float':
+        return /^-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?$/.test(v.value)
+          ? { type: 'number', raw: v.value }
+          : { type: 'string', value: v.value };
+      case 'json':
+        return tryParseJson(v.value) ?? { type: 'string', value: v.value };
+      default:
+        return { type: 'string', value: v.value };
+    }
+  };
+  return { type: 'array', items: values.map(node) };
+}
+
+/** File extension for saving a value shown in `mode`. */
+export function extensionFor(mode: ViewerMode): string {
+  switch (mode) {
+    case 'json':
+      return 'json';
+    case 'xml':
+      return 'xml';
+    case 'hex':
+      return 'bin';
+    case 'text':
+      return 'txt';
+  }
+}
diff --git a/src/features/grid/rangeStore.ts b/src/features/grid/rangeStore.ts
new file mode 100644
index 0000000..fab04e3
--- /dev/null
+++ b/src/features/grid/rangeStore.ts
@@ -0,0 +1,30 @@
+import type { Range } from './gridMath';
+
+/**
+ * The visible columns, shared between the scroll path and the header. A store rather than
+ * state of the grid: a horizontal scroll re-renders the header only, never the whole grid.
+ */
+export interface RangeStore {
+  get: () => Range;
+  set: (range: Range) => void;
+  subscribe: (listener: () => void) => () => void;
+}
+
+export function createRangeStore(): RangeStore {
+  let current: Range = { start: 0, end: 0 };
+  const listeners = new Set<() => void>();
+  return {
+    get: () => current,
+    set: (range) => {
+      if (range.start === current.start && range.end === current.end) return;
+      current = range;
+      for (const listener of [...listeners]) listener();
+    },
+    subscribe: (listener) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+  };
+}
diff --git a/src/features/grid/resultRowSource.ts b/src/features/grid/resultRowSource.ts
new file mode 100644
index 0000000..dedc1eb
--- /dev/null
+++ b/src/features/grid/resultRowSource.ts
@@ -0,0 +1,95 @@
+import { ipc, unwrap, type ColumnMeta } from '../../ipc';
+import type { RowBlock, RowSource } from './rowSource';
+import { WindowCache } from './windowCache';
+
+/** Rows per screen window (rule 8: the frontend reads windows of 500 rows). */
+export const WINDOW_ROWS = 500;
+/** Largest window the backend serves; used to read selections for a copy. */
+export const READ_CHUNK_ROWS = 2000;
+/** Cells kept in the window cache, whatever the column count (bounded memory). */
+const MAX_CACHED_CELLS = 1_500_000;
+const MIN_WINDOWS = 8;
+const MAX_WINDOWS = 400;
+
+export interface ResultRowSource extends RowSource {
+  /** The result streamed more rows (`ResultSummary.rowCount`). */
+  setRowCount(count: number): void;
+  dispose(): void;
+  /** Number of window requests sent so far (measurements). */
+  readonly fetchCount: number;
+}
+
+function abortError(): Error {
+  return new DOMException('The copy was cancelled.', 'AbortError');
+}
+
+/** A result of the backend's `ResultStore`, read through `fetch_result_window` (M1-3). */
+export function createResultRowSource(
+  resultId: number,
+  columns: readonly ColumnMeta[],
+  rowCount: number,
+): ResultRowSource {
+  const fetchWindow = (offset: number, limit: number): Promise<RowBlock> =>
+    unwrap(ipc.commands.fetchResultWindow(resultId, offset, limit));
+  const perWindow = WINDOW_ROWS * Math.max(1, columns.length);
+  const cache = new WindowCache({
+    fetch: fetchWindow,
+    windowSize: WINDOW_ROWS,
+    maxWindows: Math.max(
+      MIN_WINDOWS,
+      Math.min(MAX_WINDOWS, Math.floor(MAX_CACHED_CELLS / perWindow)),
+    ),
+  });
+  cache.setRowCount(rowCount);
+  const gridColumns = columns.map((c) => ({ name: c.name, typeName: c.typeName, kind: c.kind }));
+
+  async function read(start: number, end: number, signal?: AbortSignal): Promise<RowBlock[]> {
+    const stop = Math.min(end, cache.rowCount);
+    const blocks: RowBlock[] = [];
+    let row = Math.max(0, start);
+    while (row < stop) {
+      if (signal?.aborted) throw abortError();
+      const cached = cache.get(row);
+      if (cached) {
+        blocks.push(cached);
+        row = cached.offset + cached.rowCount;
+        continue;
+      }
+      // Up to the next cached row, in chunks the backend accepts.
+      let missingEnd = row;
+      while (missingEnd < stop && missingEnd - row < READ_CHUNK_ROWS && !cache.get(missingEnd)) {
+        missingEnd = Math.min(stop, (Math.floor(missingEnd / WINDOW_ROWS) + 1) * WINDOW_ROWS);
+      }
+      const limit = Math.min(READ_CHUNK_ROWS, Math.max(1, missingEnd - row));
+      const block = await fetchWindow(row, limit);
+      if (block.rowCount === 0) break;
+      blocks.push(block);
+      row = block.offset + block.rowCount;
+    }
+    return blocks;
+  }
+
+  return {
+    columns: gridColumns,
+    get rowCount() {
+      return cache.rowCount;
+    },
+    get fetchCount() {
+      return cache.fetchCount;
+    },
+    block: (row) => cache.get(row),
+    request: (start, end) => {
+      cache.want(start, end);
+    },
+    subscribe: (listener) => cache.subscribe(listener),
+    read,
+    loaded: () => cache.blocks(),
+    fullValue: (row, col) => unwrap(ipc.commands.fetchResultCell(resultId, row, col)),
+    setRowCount: (count) => {
+      cache.setRowCount(count);
+    },
+    dispose: () => {
+      cache.dispose();
+    },
+  };
+}
diff --git a/src/features/grid/rowSource.ts b/src/features/grid/rowSource.ts
new file mode 100644
index 0000000..960754b
--- /dev/null
+++ b/src/features/grid/rowSource.ts
@@ -0,0 +1,86 @@
+import type { Value, ValueKind } from '../../ipc';
+
+/**
+ * What the grid shows, independent of where rows come from. The query result grid reads a
+ * backend result (`resultRowSource.ts`); the table editor (M2-3) will wrap a source to overlay
+ * pending changes. Columns are in data order; the grid keeps its own display order.
+ */
+export interface GridColumn {
+  name: string;
+  /** The engine's type name, shown in the header (may be empty). */
+  typeName: string;
+  kind: ValueKind;
+}
+
+/**
+ * Consecutive loaded rows, column by column (same shape as the backend's result window). Each
+ * cell is its lossless text, `null` for SQL `NULL`. Blocks are immutable: a new block replaces
+ * an old one, so the renderer can tell repainted rows by identity.
+ */
+export interface RowBlock {
+  offset: number;
+  rowCount: number;
+  columns: readonly BlockColumn[];
+}
+
+export interface BlockColumn {
+  values: readonly (string | null)[];
+  /** Per-cell kinds when some differ from the column's (dynamically typed engines). */
+  kinds: readonly ValueKind[] | null;
+  /** Indices (in the block) of the cells cut short: the full value needs `fullValue`. */
+  truncated: readonly number[];
+}
+
+export interface RowSource {
+  readonly columns: readonly GridColumn[];
+  /** Rows that exist so far (grows while a result streams). */
+  readonly rowCount: number;
+  /** The loaded block holding `row`, or `undefined` while it is not loaded. Called per frame. */
+  block(row: number): RowBlock | undefined;
+  /** Rows `[start, end)` are on screen: load what is missing. The latest call wins. */
+  request(start: number, end: number): void;
+  /** Called when blocks arrive or `rowCount` changes. */
+  subscribe(listener: () => void): () => void;
+  /**
+   * Rows `[start, end)` for a copy or an export, loaded if needed (in order, covering the
+   * range; fewer rows if the source has fewer).
+   */
+  read(start: number, end: number, signal?: AbortSignal): Promise<RowBlock[]>;
+  /** The whole value of a cell (blocks cut long ones). */
+  fullValue(row: number, col: number): Promise<Value>;
+  /** Blocks in memory now (auto-fit measures the loaded rows). */
+  loaded(): Iterable<RowBlock>;
+}
+
+export function blockText(block: RowBlock, index: number, col: number): string | null {
+  return block.columns[col]?.values[index] ?? null;
+}
+
+export function blockKind(
+  block: RowBlock,
+  index: number,
+  col: number,
+  columnKind: ValueKind,
+): ValueKind {
+  const kinds = block.columns[col]?.kinds;
+  return kinds ? (kinds[index] ?? columnKind) : columnKind;
+}
+
+export function blockTruncated(block: RowBlock, index: number, col: number): boolean {
+  const truncated = block.columns[col]?.truncated;
+  return !!truncated && truncated.length > 0 && truncated.includes(index);
+}
+
+/** The text form of a whole value, the same as the cells of a block (`null` for NULL). */
+export function valueText(value: Value): string | null {
+  switch (value.kind) {
+    case 'null':
+      return null;
+    case 'bool':
+      return value.value ? 'true' : 'false';
+    case 'array':
+      return JSON.stringify(value.value);
+    default:
+      return value.value;
+  }
+}
diff --git a/src/features/grid/selection.test.ts b/src/features/grid/selection.test.ts
new file mode 100644
index 0000000..b255d9b
--- /dev/null
+++ b/src/features/grid/selection.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  addCell,
+  afterColumnMove,
+  cellSelection,
+  colTouched,
+  extendTo,
+  isCellSelected,
+  isColSelected,
+  isRowSelected,
+  moveFocus,
+  moveFocusTo,
+  selectAll,
+  selectCols,
+  selectedColumns,
+  selectedRowIntervals,
+  selectRows,
+} from './selection';
+
+const bounds = { rowCount: 100, colCount: 10 };
+
+describe('selection', () => {
+  it('selects one cell', () => {
+    const sel = cellSelection({ row: 3, col: 2 });
+    expect(isCellSelected(sel, 3, 2)).toBe(true);
+    expect(isCellSelected(sel, 3, 3)).toBe(false);
+    expect(isCellSelected(null, 0, 0)).toBe(false);
+  });
+
+  it('extends a range from the anchor (shift-click), in any direction', () => {
+    const sel = extendTo(cellSelection({ row: 5, col: 5 }), { row: 2, col: 7 });
+    expect(sel.anchor).toEqual({ row: 5, col: 5 });
+    expect(sel.focus).toEqual({ row: 2, col: 7 });
+    expect(sel.ranges).toEqual([{ kind: 'cells', r0: 2, r1: 5, c0: 5, c1: 7 }]);
+    expect(isCellSelected(sel, 4, 6)).toBe(true);
+    expect(isCellSelected(sel, 6, 6)).toBe(false);
+  });
+
+  it('adds disjoint cells (mod-click) and extends the last one only', () => {
+    let sel = addCell(cellSelection({ row: 0, col: 0 }), { row: 10, col: 3 });
+    sel = extendTo(sel, { row: 11, col: 4 });
+    expect(sel.ranges).toHaveLength(2);
+    expect(isCellSelected(sel, 0, 0)).toBe(true);
+    expect(isCellSelected(sel, 11, 4)).toBe(true);
+    expect(isCellSelected(sel, 5, 2)).toBe(false);
+  });
+
+  it('selects whole rows that keep growing while the result streams', () => {
+    let sel = selectRows(null, 4, 'replace');
+    sel = selectRows(sel, 6, 'extend');
+    expect(isRowSelected(sel, 5)).toBe(true);
+    expect(isCellSelected(sel, 5, 1_000)).toBe(true);
+    sel = selectRows(sel, 20, 'add');
+    expect(selectedRowIntervals(sel, 100)).toEqual([
+      { start: 4, end: 7 },
+      { start: 20, end: 21 },
+    ]);
+  });
+
+  it('selects whole columns, including rows not streamed yet', () => {
+    let sel = selectCols(cellSelection({ row: 7, col: 0 }), 2, 'replace');
+    expect(sel.focus).toEqual({ row: 7, col: 2 });
+    sel = selectCols(sel, 4, 'extend');
+    expect(isColSelected(sel, 3)).toBe(true);
+    expect(isColSelected(sel, 5)).toBe(false);
+    expect(isCellSelected(sel, 1_000_000, 3)).toBe(true);
+    expect(selectedColumns(sel, 10)).toEqual([2, 3, 4]);
+    expect(selectedRowIntervals(sel, 100)).toEqual([{ start: 0, end: 100 }]);
+  });
+
+  it('selects everything', () => {
+    const sel = selectAll(cellSelection({ row: 3, col: 3 }));
+    expect(sel.focus).toEqual({ row: 3, col: 3 });
+    expect(isRowSelected(sel, 99)).toBe(true);
+    expect(isColSelected(sel, 9)).toBe(true);
+    expect(selectedColumns(sel, 10)).toHaveLength(10);
+  });
+
+  it('marks the headers of touched columns', () => {
+    const sel = extendTo(cellSelection({ row: 1, col: 1 }), { row: 2, col: 2 });
+    expect(colTouched(sel, 2)).toBe(true);
+    expect(colTouched(sel, 3)).toBe(false);
+  });
+
+  it('moves the focus with the keyboard, clamped to the grid', () => {
+    let sel = cellSelection({ row: 0, col: 0 });
+    sel = moveFocus(sel, -1, -1, false, bounds);
+    expect(sel.focus).toEqual({ row: 0, col: 0 });
+    sel = moveFocus(sel, 30, 20, false, bounds);
+    expect(sel.focus).toEqual({ row: 30, col: 9 });
+    expect(sel.ranges).toHaveLength(1);
+  });
+
+  it('extends with shift+arrows from the anchor', () => {
+    let sel = cellSelection({ row: 5, col: 5 });
+    sel = moveFocus(sel, 1, 0, true, bounds);
+    sel = moveFocus(sel, 1, 1, true, bounds);
+    expect(sel.anchor).toEqual({ row: 5, col: 5 });
+    expect(sel.ranges).toEqual([{ kind: 'cells', r0: 5, r1: 7, c0: 5, c1: 6 }]);
+    // Back over the anchor flips the range.
+    sel = moveFocusTo(sel, { row: 3, col: 5 }, true, bounds);
+    expect(sel.ranges).toEqual([{ kind: 'cells', r0: 3, r1: 5, c0: 5, c1: 5 }]);
+  });
+
+  it('keeps a row selection a row selection when extended with the keyboard', () => {
+    const sel = moveFocus(selectRows(null, 2, 'replace'), 2, 0, true, bounds);
+    expect(sel.ranges[0]?.kind).toBe('rows');
+    expect(isRowSelected(sel, 4)).toBe(true);
+  });
+
+  it('does nothing on an empty grid', () => {
+    const sel = cellSelection({ row: 0, col: 0 });
+    expect(moveFocus(sel, 1, 0, false, { rowCount: 0, colCount: 3 })).toBe(sel);
+    expect(selectedRowIntervals(sel, 0)).toEqual([]);
+  });
+
+  it('follows a moved column', () => {
+    const sel = afterColumnMove(cellSelection({ row: 1, col: 1 }), 1, 4);
+    expect(sel?.focus).toEqual({ row: 1, col: 4 });
+    const other = afterColumnMove(cellSelection({ row: 1, col: 3 }), 1, 4);
+    expect(other?.focus.col).toBe(2);
+    const cols = afterColumnMove(selectCols(null, 0, 'replace'), 0, 2);
+    expect(cols && isColSelected(cols, 2)).toBe(true);
+  });
+});
diff --git a/src/features/grid/selection.ts b/src/features/grid/selection.ts
new file mode 100644
index 0000000..28355e5
--- /dev/null
+++ b/src/features/grid/selection.ts
@@ -0,0 +1,232 @@
+/**
+ * Selection model of the grid (F-063): ranges of cells, whole rows, whole columns or
+ * everything, plus an anchor (where a shift-extension starts) and a focus (the active cell).
+ * Columns are display indices. Pure functions over immutable values.
+ */
+
+export interface CellPos {
+  row: number;
+  col: number;
+}
+
+export type RangeKind = 'cells' | 'rows' | 'cols' | 'all';
+
+/** Inclusive bounds. Whole rows / columns / all reach `Infinity`, so they grow while streaming. */
+export interface SelRange {
+  kind: RangeKind;
+  r0: number;
+  r1: number;
+  c0: number;
+  c1: number;
+}
+
+export interface Selection {
+  ranges: readonly SelRange[];
+  anchor: CellPos;
+  focus: CellPos;
+}
+
+export interface Bounds {
+  rowCount: number;
+  colCount: number;
+}
+
+export interface Interval {
+  start: number;
+  /** Exclusive. */
+  end: number;
+}
+
+function span(kind: RangeKind, a: CellPos, b: CellPos): SelRange {
+  const rows = { r0: Math.min(a.row, b.row), r1: Math.max(a.row, b.row) };
+  const cols = { c0: Math.min(a.col, b.col), c1: Math.max(a.col, b.col) };
+  switch (kind) {
+    case 'cells':
+      return { kind, ...rows, ...cols };
+    case 'rows':
+      return { kind, ...rows, c0: 0, c1: Infinity };
+    case 'cols':
+      return { kind, r0: 0, r1: Infinity, ...cols };
+    case 'all':
+      return { kind, r0: 0, r1: Infinity, c0: 0, c1: Infinity };
+  }
+}
+
+export function cellSelection(pos: CellPos): Selection {
+  return { ranges: [span('cells', pos, pos)], anchor: pos, focus: pos };
+}
+
+function lastKind(sel: Selection): RangeKind {
+  return sel.ranges.at(-1)?.kind ?? 'cells';
+}
+
+/** Shift-click / shift-arrow: the last range spans anchor → `pos`, keeping its kind. */
+export function extendTo(sel: Selection, pos: CellPos): Selection {
+  const kind = lastKind(sel);
+  return {
+    ranges: [...sel.ranges.slice(0, -1), span(kind, sel.anchor, pos)],
+    anchor: sel.anchor,
+    focus: pos,
+  };
+}
+
+/** Mod-click: one more cell, which becomes the anchor and the focus. */
+export function addCell(sel: Selection, pos: CellPos): Selection {
+  return { ranges: [...sel.ranges, span('cells', pos, pos)], anchor: pos, focus: pos };
+}
+
+export type SelectMode = 'replace' | 'extend' | 'add';
+
+/** Click on a row number: the whole row (shift: rows from the anchor, mod: one more row). */
+export function selectRows(sel: Selection | null, row: number, mode: SelectMode): Selection {
+  const col = sel?.focus.col ?? 0;
+  const pos = { row, col };
+  if (sel && mode === 'extend') {
+    const anchor = { row: sel.anchor.row, col };
+    return {
+      ranges: [...sel.ranges.slice(0, -1), span('rows', anchor, pos)],
+      anchor,
+      focus: pos,
+    };
+  }
+  const range = span('rows', pos, pos);
+  const ranges = sel && mode === 'add' ? [...sel.ranges, range] : [range];
+  return { ranges, anchor: pos, focus: pos };
+}
+
+/** Click on a column header: the whole column (shift: columns from the anchor, mod: one more). */
+export function selectCols(sel: Selection | null, col: number, mode: SelectMode): Selection {
+  const row = sel?.focus.row ?? 0;
+  const pos = { row, col };
+  if (sel && mode === 'extend') {
+    const anchor = { row, col: sel.anchor.col };
+    return {
+      ranges: [...sel.ranges.slice(0, -1), span('cols', anchor, pos)],
+      anchor,
+      focus: pos,
+    };
+  }
+  const range = span('cols', pos, pos);
+  const ranges = sel && mode === 'add' ? [...sel.ranges, range] : [range];
+  return { ranges, anchor: pos, focus: pos };
+}
+
+export function selectAll(sel: Selection | null): Selection {
+  const focus = sel?.focus ?? { row: 0, col: 0 };
+  return { ranges: [span('all', focus, focus)], anchor: focus, focus };
+}
+
+function clampPos(pos: CellPos, b: Bounds): CellPos {
+  return {
+    row: Math.max(0, Math.min(b.rowCount - 1, pos.row)),
+    col: Math.max(0, Math.min(b.colCount - 1, pos.col)),
+  };
+}
+
+/**
+ * Keyboard move of the focus by `dRow` / `dCol` (clamped). Without `extend`, the selection
+ * collapses to the new focus; with it, the last range stretches from the anchor (a selection of
+ * whole rows or columns stays one).
+ */
+export function moveFocus(
+  sel: Selection,
+  dRow: number,
+  dCol: number,
+  extend: boolean,
+  b: Bounds,
+): Selection {
+  return moveFocusTo(sel, { row: sel.focus.row + dRow, col: sel.focus.col + dCol }, extend, b);
+}
+
+export function moveFocusTo(sel: Selection, to: CellPos, extend: boolean, b: Bounds): Selection {
+  if (b.rowCount <= 0 || b.colCount <= 0) return sel;
+  const pos = clampPos(to, b);
+  return extend ? extendTo(sel, pos) : cellSelection(pos);
+}
+
+function contains(r: SelRange, row: number, col: number): boolean {
+  return row >= r.r0 && row <= r.r1 && col >= r.c0 && col <= r.c1;
+}
+
+export function isCellSelected(sel: Selection | null, row: number, col: number): boolean {
+  if (!sel) return false;
+  for (const range of sel.ranges) if (contains(range, row, col)) return true;
+  return false;
+}
+
+/** The row is part of a whole-row (or select-all) range: its number is highlighted. */
+export function isRowSelected(sel: Selection | null, row: number): boolean {
+  if (!sel) return false;
+  for (const r of sel.ranges) {
+    if ((r.kind === 'rows' || r.kind === 'all') && row >= r.r0 && row <= r.r1) return true;
+  }
+  return false;
+}
+
+/** The column is part of a whole-column (or select-all) range: its header is highlighted. */
+export function isColSelected(sel: Selection | null, col: number): boolean {
+  if (!sel) return false;
+  for (const r of sel.ranges) {
+    if ((r.kind === 'cols' || r.kind === 'all') && col >= r.c0 && col <= r.c1) return true;
+  }
+  return false;
+}
+
+/** Some cell of the column is selected (its header is marked, like a spreadsheet). */
+export function colTouched(sel: Selection | null, col: number): boolean {
+  return !!sel?.ranges.some((r) => col >= r.c0 && col <= r.c1);
+}
+
+/** Some cell of the row is selected (its number is marked). */
+export function rowTouched(sel: Selection | null, row: number): boolean {
+  return !!sel?.ranges.some((r) => row >= r.r0 && row <= r.r1);
+}
+
+/** The rows any range covers, as merged intervals, clipped to `rowCount`. */
+export function selectedRowIntervals(sel: Selection | null, rowCount: number): Interval[] {
+  if (!sel || rowCount <= 0) return [];
+  const intervals = sel.ranges
+    .map((r) => ({ start: Math.max(0, r.r0), end: Math.min(rowCount, r.r1 + 1) }))
+    .filter((i) => i.end > i.start)
+    .sort((a, b) => a.start - b.start);
+  const merged: Interval[] = [];
+  for (const interval of intervals) {
+    const last = merged.at(-1);
+    if (last && interval.start <= last.end) last.end = Math.max(last.end, interval.end);
+    else merged.push({ ...interval });
+  }
+  return merged;
+}
+
+/** The display columns any range covers, sorted. */
+export function selectedColumns(sel: Selection | null, colCount: number): number[] {
+  if (!sel || colCount <= 0) return [];
+  const cols = new Set<number>();
+  for (const r of sel.ranges) {
+    for (let c = Math.max(0, r.c0); c <= Math.min(colCount - 1, r.c1); c++) cols.add(c);
+  }
+  return [...cols].sort((a, b) => a - b);
+}
+
+export function countRows(intervals: readonly Interval[]): number {
+  return intervals.reduce((sum, i) => sum + i.end - i.start, 0);
+}
+
+/**
+ * The selection after display column `from` moved to `to`: positions follow the moved column,
+ * ranges reset to the focus (a range of columns would no longer be contiguous).
+ */
+export function afterColumnMove(sel: Selection | null, from: number, to: number): Selection | null {
+  if (!sel) return null;
+  const remap = (c: number) => {
+    if (c === from) return to;
+    if (from < to && c > from && c <= to) return c - 1;
+    if (from > to && c >= to && c < from) return c + 1;
+    return c;
+  };
+  const focus = { row: sel.focus.row, col: remap(sel.focus.col) };
+  const kind = lastKind(sel);
+  if (kind === 'cols') return selectCols(cellSelection(focus), focus.col, 'replace');
+  if (kind === 'rows' || kind === 'all') return { ...sel, anchor: focus, focus };
+  return cellSelection(focus);
+}
diff --git a/src/features/grid/useDebouncedValue.ts b/src/features/grid/useDebouncedValue.ts
new file mode 100644
index 0000000..bbc2fbd
--- /dev/null
+++ b/src/features/grid/useDebouncedValue.ts
@@ -0,0 +1,15 @@
+import { useEffect, useState } from 'react';
+
+/** `value` once it has stayed the same for `ms` (e.g. a cell under a held arrow key). */
+export function useDebouncedValue<T extends string | number | null>(value: T, ms: number): T {
+  const [settled, setSettled] = useState(value);
+  useEffect(() => {
+    const timer = setTimeout(() => {
+      setSettled(value);
+    }, ms);
+    return () => {
+      clearTimeout(timer);
+    };
+  }, [value, ms]);
+  return settled;
+}
diff --git a/src/features/grid/useGridCopy.ts b/src/features/grid/useGridCopy.ts
new file mode 100644
index 0000000..af1fde9
--- /dev/null
+++ b/src/features/grid/useGridCopy.ts
@@ -0,0 +1,94 @@
+import { useCallback } from 'react';
+
+import { showError } from '../../app/errors/presentError';
+import { useI18nStore } from '../../i18n/i18n';
+import { useT } from '../../i18n/useT';
+import { toast, useToastStore } from '../../ui/toastStore';
+import { writeClipboard } from './clipboard';
+import { formatCopy, type CopyFormat, type CopyOptions } from './copyFormats';
+import { gatherSelection, MAX_COPY_ROWS } from './copySelection';
+import { formatCount } from './formatCount';
+import type { RowSource } from './rowSource';
+import type { Selection } from './selection';
+
+/** A copy still reading after this long shows its progress (with Cancel). */
+const PROGRESS_AFTER_MS = 300;
+
+export type CopyExtras = Pick<CopyOptions, 'tableName' | 'quoteIdentifier'>;
+
+/** Copies a selection to the clipboard in a format (F-063), reading rows as needed. */
+export function useGridCopy(source: RowSource, extras?: CopyExtras) {
+  const t = useT();
+  const locale = useI18nStore((state) => state.locale);
+  return useCallback(
+    async (
+      selection: Selection | null,
+      order: readonly number[],
+      format: CopyFormat,
+      headers: boolean,
+    ) => {
+      if (!selection) return;
+      const number = new Intl.NumberFormat(locale);
+      const controller = new AbortController();
+      const shown: { toast: number | null } = { toast: null };
+      let progress = { done: 0, total: 0 };
+      const progressTitle = () =>
+        t('grid.copy.progress', {
+          done: number.format(progress.done),
+          total: number.format(progress.total),
+        });
+      const timer = setTimeout(() => {
+        shown.toast = toast({
+          title: progressTitle(),
+          duration: Infinity,
+          action: {
+            label: t('common.cancel'),
+            onClick: () => {
+              controller.abort();
+            },
+          },
+        });
+      }, PROGRESS_AFTER_MS);
+      try {
+        const result = await gatherSelection(source, selection, order, {
+          signal: controller.signal,
+          onProgress: (done, total) => {
+            progress = { done, total };
+            if (shown.toast !== null) {
+              useToastStore.getState().update(shown.toast, { title: progressTitle() });
+            }
+          },
+        });
+        const text = formatCopy(format, result.table, { headers, ...extras });
+        await writeClipboard(text);
+        const formatName = t(`grid.format.${format}`);
+        if (result.copiedRows < result.selectedRows) {
+          toast({
+            variant: 'warning',
+            title: t('grid.copy.limited', {
+              copied: number.format(result.copiedRows),
+              total: number.format(result.selectedRows),
+            }),
+            description: t('grid.copy.limited.hint', { limit: number.format(MAX_COPY_ROWS) }),
+          });
+        } else {
+          toast({
+            variant: 'success',
+            title: formatCount(locale, 'grid.copy.done', result.copiedRows, {
+              format: formatName,
+            }),
+            duration: 2000,
+          });
+        }
+      } catch (error) {
+        if (!(error instanceof DOMException && error.name === 'AbortError')) {
+          showError(error, { title: t('grid.copy.failed') });
+        }
+      } finally {
+        clearTimeout(timer);
+        if (shown.toast !== null) useToastStore.getState().dismiss(shown.toast);
+      }
+    },
+    [source, extras, t, locale],
+  );
+}
diff --git a/src/features/grid/windowCache.test.ts b/src/features/grid/windowCache.test.ts
new file mode 100644
index 0000000..431f6d1
--- /dev/null
+++ b/src/features/grid/windowCache.test.ts
@@ -0,0 +1,189 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { RowBlock } from './rowSource';
+import { WindowCache } from './windowCache';
+
+interface Pending {
+  offset: number;
+  limit: number;
+  resolve: (rows?: number) => void;
+  reject: () => void;
+}
+
+function setup(
+  rowCount: number,
+  options: { maxWindows?: number; maxConcurrent?: number; settleMs?: number } = {},
+) {
+  const pending: Pending[] = [];
+  let available = rowCount;
+  const cache = new WindowCache({
+    windowSize: 10,
+    maxWindows: options.maxWindows ?? 100,
+    maxConcurrent: options.maxConcurrent ?? 2,
+    refreshMs: 100,
+    retryMs: 1000,
+    settleMs: options.settleMs ?? 0,
+    movingGapMs: 150,
+    now: () => Date.now(),
+    fetch: (offset, limit) =>
+      new Promise<RowBlock>((resolve, reject) => {
+        pending.push({
+          offset,
+          limit,
+          resolve: (rows) => {
+            const count = Math.max(0, Math.min(limit, (rows ?? available) - offset));
+            resolve({
+              offset,
+              rowCount: count,
+              columns: [
+                {
+                  values: Array.from({ length: count }, (_, i) => `r${String(offset + i)}`),
+                  kinds: null,
+                  truncated: [],
+                },
+              ],
+            });
+          },
+          reject: () => {
+            reject(new Error('boom'));
+          },
+        });
+      }),
+  });
+  cache.setRowCount(rowCount);
+  const flush = async () => {
+    while (pending.length > 0) {
+      for (const p of pending.splice(0)) p.resolve();
+      await Promise.resolve();
+      await Promise.resolve();
+    }
+  };
+  return {
+    cache,
+    pending,
+    flush,
+    grow: (count: number) => {
+      available = count;
+      cache.setRowCount(count);
+    },
+  };
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe('WindowCache', () => {
+  it('fetches the visible windows, nearest the middle first, a few at a time', async () => {
+    const { cache, pending, flush } = setup(1000);
+    cache.want(30, 60);
+    expect(pending.map((p) => p.offset)).toEqual([40, 30]);
+    await flush();
+    expect(cache.get(35)?.offset).toBe(30);
+    expect(cache.get(59)?.columns[0]?.values[9]).toBe('r59');
+    // Neighbours are prefetched after the visible windows.
+    expect(cache.get(25)).toBeDefined();
+    expect(cache.get(65)).toBeDefined();
+    expect(cache.get(95)).toBeUndefined();
+  });
+
+  it('does not queue every window crossed while the scrollbar is dragged', async () => {
+    const { cache, pending, flush } = setup(1_000_000, { settleMs: 60 });
+    // One new viewport per frame for a second.
+    for (let frame = 0; frame < 60; frame++) {
+      cache.want(frame * 16_007, frame * 16_007 + 30);
+      await flush();
+      vi.advanceTimersByTime(16);
+    }
+    // While moving: one visible window at most every 150 ms, no neighbours.
+    expect(cache.fetchCount).toBeLessThanOrEqual(8);
+    expect(pending).toHaveLength(0);
+    // Once settled: the last viewport, then its neighbours.
+    vi.advanceTimersByTime(200);
+    await flush();
+    const last = 59 * 16_007;
+    expect(cache.get(last)).toBeDefined();
+    expect(cache.get(last + 29)).toBeDefined();
+    expect(cache.get(last - 10)).toBeDefined();
+  });
+
+  it('keeps memory bounded and evicts what is no longer wanted', async () => {
+    const { cache, flush } = setup(10_000, { maxWindows: 5 });
+    for (let row = 0; row < 500; row += 20) {
+      cache.want(row, row + 10);
+      await flush();
+    }
+    expect(cache.size).toBeLessThanOrEqual(5);
+    expect(cache.get(495)).toBeDefined();
+    expect(cache.get(0)).toBeUndefined();
+  });
+
+  it('refetches the last window while a streaming result grows, at a bounded rate', async () => {
+    const { cache, pending, flush, grow } = setup(15);
+    cache.want(0, 30);
+    await flush();
+    expect(cache.get(14)).toBeDefined();
+    expect(cache.get(15)).toBeUndefined();
+    grow(18);
+    cache.want(0, 30);
+    // Fetched less than 100 ms ago: waits.
+    expect(pending).toHaveLength(0);
+    vi.advanceTimersByTime(100);
+    expect(pending.map((p) => p.offset)).toEqual([10]);
+    await flush();
+    expect(cache.get(17)?.columns[0]?.values[7]).toBe('r17');
+  });
+
+  it('asks a window again once an answer older than the row count arrives', async () => {
+    const { cache, pending, grow } = setup(12);
+    cache.want(0, 20);
+    const second = pending.find((p) => p.offset === 10);
+    grow(20);
+    cache.want(0, 20);
+    // One request per window at a time.
+    expect(pending.filter((p) => p.offset === 10)).toHaveLength(1);
+    second?.resolve(12);
+    await Promise.resolve();
+    await Promise.resolve();
+    expect(cache.get(11)).toBeDefined();
+    expect(cache.get(19)).toBeUndefined();
+    vi.advanceTimersByTime(100);
+    const again = pending.filter((p) => p.offset === 10 && p !== second);
+    expect(again).toHaveLength(1);
+    again[0]?.resolve();
+    await Promise.resolve();
+    expect(cache.get(19)).toBeDefined();
+  });
+
+  it('retries a failed window later, then gives up', async () => {
+    const { cache, pending } = setup(10, { maxConcurrent: 1 });
+    cache.want(0, 10);
+    for (let attempt = 0; attempt < 3; attempt++) {
+      expect(pending).toHaveLength(1);
+      pending.shift()?.reject();
+      await Promise.resolve();
+      await Promise.resolve();
+      expect(pending).toHaveLength(0);
+      vi.advanceTimersByTime(1000);
+    }
+    expect(pending).toHaveLength(0);
+    expect(cache.fetchCount).toBe(3);
+  });
+
+  it('notifies subscribers when blocks arrive', async () => {
+    const { cache, flush } = setup(10);
+    const listener = vi.fn();
+    const unsubscribe = cache.subscribe(listener);
+    cache.want(0, 10);
+    await flush();
+    expect(listener).toHaveBeenCalled();
+    unsubscribe();
+    listener.mockClear();
+    cache.setRowCount(5);
+    expect(listener).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/features/grid/windowCache.ts b/src/features/grid/windowCache.ts
new file mode 100644
index 0000000..345dc68
--- /dev/null
+++ b/src/features/grid/windowCache.ts
@@ -0,0 +1,243 @@
+import type { RowBlock } from './rowSource';
+
+export interface WindowCacheOptions {
+  /** Loads rows `[offset, offset + limit)` (fewer at the end). */
+  fetch: (offset: number, limit: number) => Promise<RowBlock>;
+  /** Rows per window (the backend serves windows of 500). */
+  windowSize?: number;
+  /** Windows kept in memory; the least recently wanted ones go first. */
+  maxWindows: number;
+  /** Requests in flight at once: scrolling fast never queues more than this. */
+  maxConcurrent?: number;
+  /** A window that is still filling (streaming) is fetched again at most this often. */
+  refreshMs?: number;
+  /** Wait before retrying a window whose fetch failed; three failures give up. */
+  retryMs?: number;
+  /**
+   * The viewport counts as moving until it has wanted the same windows this long. While it
+   * moves (a dragged scrollbar wants new windows every frame), visible windows are fetched one
+   * at a time at most every `movingGapMs`, and neighbours not at all.
+   */
+  settleMs?: number;
+  movingGapMs?: number;
+  now?: () => number;
+}
+
+const MAX_ATTEMPTS = 3;
+
+/**
+ * Bounded cache of row windows with a fetch scheduler. Only the windows the viewport wants
+ * (latest call) are fetched, nearest first, a few at a time: dragging the scrollbar across a
+ * million rows costs a handful of requests, not one per window crossed.
+ */
+export class WindowCache {
+  readonly windowSize: number;
+  /** Windows requested so far (for tests and measurements). */
+  fetchCount = 0;
+
+  private readonly options: Required<Omit<WindowCacheOptions, 'now'>> & { now: () => number };
+  /** Map order is recency: a wanted window is moved to the end. */
+  private readonly blockMap = new Map<number, RowBlock>();
+  private readonly inflight = new Set<number>();
+  private readonly lastFetch = new Map<number, number>();
+  private readonly failures = new Map<number, { count: number; at: number }>();
+  private readonly listeners = new Set<() => void>();
+  private wanted: number[] = [];
+  private wantedKey = '';
+  /** How many of `wanted` are on screen (the rest are neighbours). */
+  private visibleCount = 0;
+  private movedAt = -Infinity;
+  private lastStart = -Infinity;
+  private rows = 0;
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private disposed = false;
+
+  constructor(options: WindowCacheOptions) {
+    this.options = {
+      windowSize: 500,
+      maxConcurrent: 2,
+      refreshMs: 100,
+      retryMs: 1000,
+      settleMs: 60,
+      movingGapMs: 150,
+      now: () => performance.now(),
+      ...options,
+    };
+    this.windowSize = this.options.windowSize;
+  }
+
+  get rowCount(): number {
+    return this.rows;
+  }
+
+  get size(): number {
+    return this.blockMap.size;
+  }
+
+  /** The loaded block holding `row`, if that row is loaded. */
+  get(row: number): RowBlock | undefined {
+    const block = this.blockMap.get(Math.floor(row / this.windowSize));
+    return block && row - block.offset < block.rowCount ? block : undefined;
+  }
+
+  /** Any loaded block of window `index`, even one still filling. */
+  peekWindow(index: number): RowBlock | undefined {
+    return this.blockMap.get(index);
+  }
+
+  /** Every block in memory. */
+  blocks(): IterableIterator<RowBlock> {
+    return this.blockMap.values();
+  }
+
+  setRowCount(count: number): void {
+    if (count === this.rows) return;
+    this.rows = count;
+    // The windows around the viewport depend on the row count: recompute them on the next call.
+    this.wantedKey = '';
+    for (const index of [...this.blockMap.keys()]) {
+      if (index * this.windowSize >= count) this.blockMap.delete(index);
+    }
+    this.notify();
+    this.pump();
+  }
+
+  /** Rows `[start, end)` are visible: fetch their windows first, then one on each side. */
+  want(start: number, end: number): void {
+    const size = this.windowSize;
+    const first = Math.max(0, Math.floor(start / size));
+    const last = Math.max(first, Math.floor((Math.max(start, end) - 1) / size));
+    const key = `${first}:${last}`;
+    if (key === this.wantedKey) {
+      this.pump();
+      return;
+    }
+    this.wantedKey = key;
+    this.movedAt = this.options.now();
+    const middle = (first + last) / 2;
+    const visible: number[] = [];
+    for (let i = first; i <= last; i++) visible.push(i);
+    visible.sort((a, b) => Math.abs(a - middle) - Math.abs(b - middle));
+    const lastWindow = Math.ceil(this.rows / size) - 1;
+    const around = [first - 1, last + 1].filter((i) => i >= 0 && i <= lastWindow);
+    this.wanted = [...visible, ...around];
+    this.visibleCount = visible.length;
+    for (const index of this.wanted) {
+      const block = this.blockMap.get(index);
+      if (block) {
+        this.blockMap.delete(index);
+        this.blockMap.set(index, block);
+      }
+    }
+    this.pump();
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    if (this.timer !== null) clearTimeout(this.timer);
+    this.timer = null;
+    this.listeners.clear();
+    this.blockMap.clear();
+  }
+
+  private expected(index: number): number {
+    return Math.max(0, Math.min(this.windowSize, this.rows - index * this.windowSize));
+  }
+
+  /** 0: fetch now; a positive number: fetch in that many ms; `null`: nothing to fetch. */
+  private due(index: number, now: number): number | null {
+    const expected = this.expected(index);
+    if (expected === 0 || this.inflight.has(index)) return null;
+    const block = this.blockMap.get(index);
+    if (block && block.rowCount >= expected) return null;
+    const failure = this.failures.get(index);
+    if (failure) {
+      if (failure.count >= MAX_ATTEMPTS) return null;
+      const wait = failure.at + this.options.retryMs - now;
+      if (wait > 0) return wait;
+    }
+    if (block) {
+      const wait = (this.lastFetch.get(index) ?? 0) + this.options.refreshMs - now;
+      if (wait > 0) return wait;
+    }
+    return 0;
+  }
+
+  private pump(): void {
+    if (this.disposed) return;
+    const now = this.options.now();
+    const { settleMs, movingGapMs, maxConcurrent } = this.options;
+    const settledIn = this.movedAt + settleMs - now;
+    const moving = settledIn > 0;
+    let nextWait = moving ? settledIn : Infinity;
+    for (const [position, index] of this.wanted.entries()) {
+      if (this.inflight.size >= maxConcurrent) break;
+      if (moving && position >= this.visibleCount) break;
+      const wait = this.due(index, now);
+      if (wait === null) continue;
+      const gap = moving ? this.lastStart + movingGapMs - now : 0;
+      if (wait > 0 || gap > 0) {
+        nextWait = Math.min(nextWait, Math.max(wait, gap));
+        continue;
+      }
+      this.start(index, now);
+      if (moving) break;
+    }
+    if (nextWait !== Infinity && this.timer === null) {
+      this.timer = setTimeout(() => {
+        this.timer = null;
+        this.pump();
+      }, nextWait);
+    }
+  }
+
+  private start(index: number, now: number): void {
+    this.inflight.add(index);
+    this.lastStart = now;
+    this.lastFetch.set(index, now);
+    this.fetchCount++;
+    this.options.fetch(index * this.windowSize, this.windowSize).then(
+      (block) => {
+        this.inflight.delete(index);
+        if (this.disposed) return;
+        this.failures.delete(index);
+        const old = this.blockMap.get(index);
+        // A slower, older answer never replaces a fuller block.
+        if (!old || block.rowCount >= old.rowCount) {
+          this.blockMap.delete(index);
+          if (index * this.windowSize < this.rows) this.blockMap.set(index, block);
+          this.evict();
+          this.notify();
+        }
+        this.pump();
+      },
+      () => {
+        this.inflight.delete(index);
+        if (this.disposed) return;
+        const count = (this.failures.get(index)?.count ?? 0) + 1;
+        this.failures.set(index, { count, at: this.options.now() });
+        this.pump();
+      },
+    );
+  }
+
+  private evict(): void {
+    if (this.blockMap.size <= this.options.maxWindows) return;
+    const keep = new Set(this.wanted);
+    for (const index of this.blockMap.keys()) {
+      if (this.blockMap.size <= this.options.maxWindows) break;
+      if (!keep.has(index)) this.blockMap.delete(index);
+    }
+  }
+
+  private notify(): void {
+    for (const listener of [...this.listeners]) listener();
+  }
+}
