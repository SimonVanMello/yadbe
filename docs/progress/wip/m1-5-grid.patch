@@ -0,0 +1,124 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import type { Value } from '../../ipc';
+import { clipIntervals, gatherSelection } from './copySelection';
+import type { RowBlock, RowSource } from './rowSource';
+import { cellSelection, extendTo, selectAll, selectCols, selectRows } from './selection';
+
+/** 3 columns; row r has `r`, `name r` (cut on every 4th row), and NULL on odd rows. */
+function fakeSource(rowCount: number) {
+  const read = vi.fn((start: number, end: number): Promise<RowBlock[]> => {
+    const count = Math.max(0, Math.min(end, rowCount) - start);
+    const rows = Array.from({ length: count }, (_, i) => start + i);
+    return Promise.resolve([
+      {
+        offset: start,
+        rowCount: count,
+        columns: [
+          { values: rows.map(String), kinds: null, truncated: [] },
+          {
+            values: rows.map((r) => (r % 4 === 0 ? 'cut…' : `name ${String(r)}`)),
+            kinds: null,
+            truncated: rows.flatMap((r, i) => (r % 4 === 0 ? [i] : [])),
+          },
+          { values: rows.map((r) => (r % 2 ? null : 'x')), kinds: null, truncated: [] },
+        ],
+      },
+    ]);
+  });
+  const fullValue = vi.fn((row: number): Promise<Value> =>
+    Promise.resolve({ kind: 'text', value: `full name ${String(row)}` }),
+  );
+  const source: RowSource = {
+    columns: [
+      { name: 'id', typeName: 'int8', kind: 'int' },
+      { name: 'name', typeName: 'text', kind: 'text' },
+      { name: 'flag', typeName: 'text', kind: 'text' },
+    ],
+    rowCount,
+    block: () => undefined,
+    request: () => undefined,
+    subscribe: () => () => undefined,
+    read,
+    fullValue,
+    loaded: () => [],
+  };
+  return { source, read, fullValue };
+}
+
+describe('gatherSelection', () => {
+  it('copies a range in display order, completing cut cells', async () => {
+    const { source, fullValue } = fakeSource(10);
+    // Display order puts `flag` first.
+    const order = [2, 0, 1];
+    const sel = extendTo(cellSelection({ row: 0, col: 0 }), { row: 1, col: 2 });
+    const result = await gatherSelection(source, sel, order);
+    expect(result.table.columns.map((c) => c.name)).toEqual(['flag', 'id', 'name']);
+    expect(result.table.rows).toEqual([
+      [
+        { text: 'x', kind: 'text' },
+        { text: '0', kind: 'int' },
+        { text: 'full name 0', kind: 'text' },
+      ],
+      [
+        { text: null, kind: 'text' },
+        { text: '1', kind: 'int' },
+        { text: 'name 1', kind: 'text' },
+      ],
+    ]);
+    expect(fullValue).toHaveBeenCalledTimes(1);
+  });
+
+  it('copies disjoint rows as one table', async () => {
+    const { source } = fakeSource(10);
+    const sel = selectRows(selectRows(null, 2, 'replace'), 7, 'add');
+    const result = await gatherSelection(source, sel, [0, 1, 2]);
+    expect(result.table.rows.map((r) => r[0]?.text)).toEqual(['2', '7']);
+    expect(result.table.columns).toHaveLength(3);
+  });
+
+  it('bounds huge selections and reports progress', async () => {
+    const { source, read } = fakeSource(1_000_000);
+    const progress = vi.fn();
+    const sel = selectCols(null, 0, 'replace');
+    const result = await gatherSelection(source, sel, [0, 1, 2], {
+      maxRows: 2_500,
+      onProgress: progress,
+    });
+    expect(result.selectedRows).toBe(1_000_000);
+    expect(result.copiedRows).toBe(2_500);
+    expect(read).toHaveBeenCalledWith(0, 2_500, undefined);
+    expect(progress).toHaveBeenCalledWith(2_500, 2_500);
+  });
+
+  it('bounds by cells on wide selections', async () => {
+    const { source } = fakeSource(1000);
+    const result = await gatherSelection(source, selectAll(null), [0, 1, 2], { maxCells: 30 });
+    expect(result.copiedRows).toBe(10);
+  });
+
+  it('stops when cancelled', async () => {
+    const { source } = fakeSource(100);
+    const controller = new AbortController();
+    controller.abort();
+    await expect(
+      gatherSelection(source, selectAll(null), [0, 1, 2], { signal: controller.signal }),
+    ).rejects.toThrow(/cancelled/);
+  });
+});
+
+it('clips intervals to a row budget', () => {
+  expect(
+    clipIntervals(
+      [
+        { start: 0, end: 5 },
+        { start: 10, end: 20 },
+        { start: 30, end: 40 },
+      ],
+      8,
+    ),
+  ).toEqual([
+    { start: 0, end: 5 },
+    { start: 10, end: 13 },
+  ]);
+});
diff --git a/src/features/grid/copySelection.ts b/src/features/grid/copySelection.ts
new file mode 100644
index 0000000..3152780
--- /dev/null
+++ b/src/features/grid/copySelection.ts
@@ -0,0 +1,114 @@
+import type { CopyCell, CopyTable } from './copyFormats';
+import { blockKind, blockText, blockTruncated, valueText, type RowSource } from './rowSource';
+import {
+  countRows,
+  selectedColumns,
+  selectedRowIntervals,
+  type Interval,
+  type Selection,
+} from './selection';
+
+/** Most rows one copy reads; a bigger selection copies its first rows and says so. */
+export const MAX_COPY_ROWS = 100_000;
+/** Most cells one copy reads (wide results copy fewer rows). */
+export const MAX_COPY_CELLS = 2_000_000;
+const FULL_VALUE_CONCURRENCY = 6;
+
+export interface GatherOptions {
+  signal?: AbortSignal;
+  /** Rows read so far out of the rows to copy, then cut cells completed out of their count. */
+  onProgress?: (done: number, total: number) => void;
+  maxRows?: number;
+  maxCells?: number;
+}
+
+export interface GatherResult {
+  table: CopyTable;
+  /** Rows the selection covers. */
+  selectedRows: number;
+  /** Rows actually copied (fewer when the selection exceeds the bound). */
+  copiedRows: number;
+}
+
+/** The first `limit` rows of the intervals. */
+export function clipIntervals(intervals: readonly Interval[], limit: number): Interval[] {
+  const out: Interval[] = [];
+  let left = limit;
+  for (const interval of intervals) {
+    if (left <= 0) break;
+    const end = Math.min(interval.end, interval.start + left);
+    out.push({ start: interval.start, end });
+    left -= end - interval.start;
+  }
+  return out;
+}
+
+/**
+ * The selected cells as a table, in display order: rows any range covers × columns any range
+ * covers. Rows not loaded yet are read from the source; cells cut short are read whole.
+ */
+export async function gatherSelection(
+  source: RowSource,
+  selection: Selection,
+  order: readonly number[],
+  options: GatherOptions = {},
+): Promise<GatherResult> {
+  const columns = selectedColumns(selection, order.length).map((c) => order[c] ?? c);
+  const intervals = selectedRowIntervals(selection, source.rowCount);
+  const selectedRows = countRows(intervals);
+  const maxCells = options.maxCells ?? MAX_COPY_CELLS;
+  const limit = Math.min(
+    selectedRows,
+    options.maxRows ?? MAX_COPY_ROWS,
+    Math.max(1, Math.floor(maxCells / Math.max(1, columns.length))),
+  );
+  const rows: CopyCell[][] = [];
+  const cut: { cell: CopyCell; row: number; col: number }[] = [];
+
+  for (const { start, end } of clipIntervals(intervals, limit)) {
+    const blocks = await source.read(start, end, options.signal);
+    for (const block of blocks) {
+      const from = Math.max(start, block.offset);
+      const to = Math.min(end, block.offset + block.rowCount);
+      for (let row = from; row < to; row++) {
+        const index = row - block.offset;
+        const cells = columns.map((col): CopyCell => {
+          const kind = blockKind(block, index, col, source.columns[col]?.kind ?? 'text');
+          const cell = { text: blockText(block, index, col), kind };
+          if (blockTruncated(block, index, col)) cut.push({ cell, row, col });
+          return cell;
+        });
+        rows.push(cells);
+      }
+    }
+    options.onProgress?.(rows.length, limit);
+  }
+
+  let next = 0;
+  let done = 0;
+  const worker = async () => {
+    while (next < cut.length) {
+      if (options.signal?.aborted) throw new DOMException('The copy was cancelled.', 'AbortError');
+      const item = cut[next++];
+      if (!item) break;
+      item.cell.text = valueText(await source.fullValue(item.row, item.col));
+      done++;
+      if (done % 50 === 0) options.onProgress?.(done, cut.length);
+    }
+  };
+  await Promise.all(
+    Array.from({ length: Math.min(FULL_VALUE_CONCURRENCY, cut.length) }, () => worker()),
+  );
+
+  return {
+    table: {
+      columns: columns.map((col) => ({
+        name: source.columns[col]?.name ?? '',
+        kind: source.columns[col]?.kind ?? 'text',
+      })),
+      rows,
+    },
+    selectedRows,
+    copiedRows: rows.length,
+  };
+}
