+  test.use({ colorScheme: 'dark', locale: 'en-US' });
+
+  test('copies TSV and the other formats, exactly', async ({ page, context }) => {
+    await context.grantPermissions(['clipboard-read', 'clipboard-write']);
+    await open(page, 'select * from orders');
