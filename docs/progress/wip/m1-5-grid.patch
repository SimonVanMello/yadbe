--- /dev/null
+++ b/src/features/grid/ResultGrid.tsx
@@ -0,0 +1,19 @@
+import type { ResultSummary } from '../../ipc';
+import { ResultGridView } from './ResultGridView';
+
+export interface ResultGridProps {
+  resultId: number;
+  /** The latest summary of the result; re-rendered as it streams. */
+  summary: ResultSummary;
+  /** Accessible name; defaults to "Result n" from the statement index. */
+  label?: string;
+}
+
+/**
+ * A backend result (M1-3 `ResultStore`) in the data grid: windows read on demand, rows appearing
+ * while they stream (F-062), and the footer with the row count and Load more / Load all.
+ */
+export function ResultGrid(props: ResultGridProps) {
+  // A new result is a new grid: selection, widths and caches start over.
+  return <ResultGridView key={props.resultId} {...props} />;
+}
diff --git a/src/features/grid/ResultGridView.tsx b/src/features/grid/ResultGridView.tsx
new file mode 100644
index 0000000..518d6b0
--- /dev/null
+++ b/src/features/grid/ResultGridView.tsx
@@ -0,0 +1,96 @@
+import { useLayoutEffect, useState } from 'react';
+
+import { showError } from '../../app/errors/presentError';
+import { useI18nStore } from '../../i18n/i18n';
+import { useT } from '../../i18n/useT';
+import { ipc, unwrap, type ResumeMode } from '../../ipc';
+import { Button } from '../../ui/Button';
+import { Spinner } from '../../ui/Spinner';
+import { DataGrid } from './DataGrid';
+import { formatCount } from './formatCount';
+import type { ResultGridProps } from './ResultGrid';
+import { createResultRowSource } from './resultRowSource';
+import styles from './ResultGrid.module.css';
+
+/** `ResultGrid` for one result id (remounted when the id changes). */
+export function ResultGridView({ resultId, summary, label }: ResultGridProps) {
+  const t = useT();
+  const locale = useI18nStore((state) => state.locale);
+  const [source] = useState(() =>
+    createResultRowSource(resultId, summary.columns, summary.rowCount),
+  );
+  const [resuming, setResuming] = useState(false);
+
+  useLayoutEffect(() => {
+    source.setRowCount(summary.rowCount);
+  }, [source, summary.rowCount]);
+
+  const resume = (mode: ResumeMode) => {
+    setResuming(true);
+    unwrap(ipc.commands.resumeResult(resultId, mode))
+      .catch((error: unknown) => {
+        showError(error, { title: t('grid.loadFailed') });
+      })
+      .finally(() => {
+        setResuming(false);
+      });
+  };
+
+  const { status, pausedBy } = summary;
+  const footer = (
+    <>
+      <span className={styles.count}>{formatCount(locale, 'grid.rows', summary.rowCount)}</span>
+      {status === 'streaming' && (
+        <span className={styles.status} role="status">
+          <Spinner />
+          {t('grid.status.streaming')}
+        </span>
+      )}
+      {status === 'paused' && (
+        <>
+          <span className={styles.paused} role="status">
+            {t(
+              pausedBy === 'memoryLimit'
+                ? 'grid.status.paused.memoryLimit'
+                : 'grid.status.paused.rowLimit',
+            )}
+          </span>
+          <Button
+            size="sm"
+            disabled={resuming}
+            onClick={() => {
+              resume('more');
+            }}
+          >
+            {t('grid.loadMore')}
+          </Button>
+          <Button
+            size="sm"
+            variant="ghost"
+            disabled={resuming}
+            onClick={() => {
+              resume('all');
+            }}
+          >
+            {t('grid.loadAll')}
+          </Button>
+        </>
+      )}
+      {(status === 'cancelled' || status === 'failed') && (
+        <span className={styles.stopped} role="status">
+          {t(status === 'cancelled' ? 'grid.status.cancelled' : 'grid.status.failed')}
+        </span>
+      )}
+    </>
+  );
+
+  return (
+    <DataGrid
+      source={source}
+      sourceKey={`result-${String(resultId)}`}
+      label={label ?? t('grid.label', { number: summary.statementIndex + 1 })}
+      footer={footer}
+      emptyText={status === 'streaming' ? undefined : t('grid.noRows')}
+    />
+  );
+}
diff --git a/src/features/grid/XmlView.tsx b/src/features/grid/XmlView.tsx
new file mode 100644
index 0000000..a9b5700
--- /dev/null
+++ b/src/features/grid/XmlView.tsx
@@ -0,0 +1,164 @@
+import { useState, type CSSProperties, type ReactNode } from 'react';
+
+import { useT } from '../../i18n/useT';
+import { Icon } from '../../ui/Icon';
+import styles from './CellViewer.module.css';
+import type { Openness } from './JsonView';
+import type { XmlNode } from './prettyValue';
+
+const CHUNK = 200;
+
+interface XmlViewProps {
+  nodes: XmlNode[];
+  openness: Openness;
+}
+
+function depthStyle(depth: number): CSSProperties {
+  return { '--depth': depth } as CSSProperties;
+}
+
+/** A pretty-printed, foldable XML document. */
+export function XmlView({ nodes, openness }: XmlViewProps) {
+  const t = useT();
+  const [overrides, setOverrides] = useState<ReadonlyMap<string, boolean>>(new Map());
+  const [limits, setLimits] = useState<ReadonlyMap<string, number>>(new Map());
+
+  const isOpen = (path: string, depth: number) => {
+    const override = overrides.get(path);
+    if (override !== undefined) return override;
+    if (openness === 'all') return true;
+    if (openness === 'none') return depth === 0;
+    return depth < 3;
+  };
+
+  const lines: ReactNode[] = [];
+  const attributes = (attrs: [string, string][]) =>
+    attrs.map(([name, value]) => (
+      <span key={name}>
+        {' '}
+        <span className={styles.attrName}>{name}</span>
+        <span className={styles.punct}>=</span>
+        <span className={styles.string}>{JSON.stringify(value)}</span>
+      </span>
+    ));
+
+  const walk = (node: XmlNode, path: string, depth: number) => {
+    const line = (content: ReactNode, toggle: ReactNode = null, key = path) => {
+      lines.push(
+        <div key={key} className={styles.line} style={depthStyle(depth)}>
+          {toggle ?? <span className={styles.toggleSpacer} />}
+          {content}
+        </div>,
+      );
+    };
+    switch (node.type) {
+      case 'text':
+        line(<span>{node.text}</span>);
+        return;
+      case 'cdata':
+        line(<span className={styles.comment}>{`<![CDATA[${node.text}]]>`}</span>);
+        return;
+      case 'comment':
+        line(<span className={styles.comment}>{`<!-- ${node.text} -->`}</span>);
+        return;
+      case 'instruction':
+        line(<span className={styles.comment}>{`<?${node.target} ${node.text}?>`}</span>);
+        return;
+      case 'element':
+        break;
+    }
+    const open = (
+      <>
+        <span className={styles.punct}>&lt;</span>
+        <span className={styles.tag}>{node.name}</span>
+        {attributes(node.attributes)}
+      </>
+    );
+    const close = (
+      <>
+        <span className={styles.punct}>&lt;/</span>
+        <span className={styles.tag}>{node.name}</span>
+        <span className={styles.punct}>&gt;</span>
+      </>
+    );
+    const [only] = node.children;
+    if (node.children.length === 0) {
+      line(
+        <>
+          {open}
+          <span className={styles.punct}>/&gt;</span>
+        </>,
+      );
+      return;
+    }
+    if (node.children.length === 1 && only?.type === 'text' && only.text.length <= 120) {
+      line(
+        <>
+          {open}
+          <span className={styles.punct}>&gt;</span>
+          <span>{only.text}</span>
+          {close}
+        </>,
+      );
+      return;
+    }
+    const expanded = isOpen(path, depth);
+    const toggle = (
+      <button
+        type="button"
+        className={styles.toggle}
+        aria-expanded={expanded}
+        aria-label={node.name}
+        onClick={() => {
+          setOverrides((map) => new Map(map).set(path, !expanded));
+        }}
+      >
+        <Icon name={expanded ? 'chevronDown' : 'chevronRight'} />
+      </button>
+    );
+    if (!expanded) {
+      line(
+        <>
+          {open}
+          <span className={styles.punct}>&gt;…</span>
+          {close}
+        </>,
+        toggle,
+      );
+      return;
+    }
+    line(
+      <>
+        {open}
+        <span className={styles.punct}>&gt;</span>
+      </>,
+      toggle,
+    );
+    const limit = limits.get(path) ?? CHUNK;
+    node.children.slice(0, limit).forEach((child, i) => {
+      walk(child, `${path}/${String(i)}`, depth + 1);
+    });
+    if (node.children.length > limit) {
+      lines.push(
+        <div key={`${path}/more`} className={styles.line} style={depthStyle(depth + 1)}>
+          <span className={styles.toggleSpacer} />
+          <button
+            type="button"
+            className={styles.more}
+            onClick={() => {
+              setLimits((map) => new Map(map).set(path, limit + CHUNK));
+            }}
+          >
+            {t('grid.viewer.more', { count: Math.min(CHUNK, node.children.length - limit) })}
+          </button>
+        </div>,
+      );
+    }
+    line(close, null, `${path}/end`);
+  };
+
+  nodes.forEach((node, i) => {
+    walk(node, String(i), 0);
+  });
+  return <div className={styles.code}>{lines}</div>;
+}
