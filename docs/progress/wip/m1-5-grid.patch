+import { describe, expect, it } from 'vitest';
+
+import { describeCell, displayLength, DISPLAY_CHARS } from './cellDisplay';
+import { isNumericKind } from './cellJson';
+
+describe('describeCell', () => {
+  it('tells NULL, the empty string and whitespace apart', () => {
+    expect(describeCell(null, 'text')).toEqual({ type: 'null' });
+    expect(describeCell('', 'text')).toEqual({ type: 'empty' });
+    expect(describeCell('  ', 'text')).toEqual({
+      type: 'marked',
+      parts: [{ text: '··', mark: true }],
+    });
+  });
+
+  it('marks leading and trailing whitespace and line breaks', () => {
+    expect(describeCell(' a b\tc\n', 'text')).toEqual({
+      type: 'marked',
+      parts: [
+        { text: '·', mark: true },
+        { text: 'a b', mark: false },
+        { text: '→', mark: true },
+        { text: 'c', mark: false },
+        { text: '↵', mark: true },
+      ],
+    });
+    expect(describeCell('one\r\ntwo', 'text')).toEqual({
+      type: 'marked',
+      parts: [
+        { text: 'one', mark: false },
+        { text: '␍↵', mark: true },
+        { text: 'two', mark: false },
+      ],
+    });
+  });
+
+  it('leaves ordinary text and numbers alone', () => {
+    expect(describeCell('hello world', 'text')).toEqual({ type: 'plain', text: 'hello world' });
+    expect(describeCell('-12.50', 'decimal')).toEqual({ type: 'plain', text: '-12.50' });
+  });
+
+  it('shows arrays as plain JSON', () => {
+    const text = JSON.stringify([{ kind: 'int', value: '9007199254740993' }, { kind: 'null' }]);
+    expect(describeCell(text, 'array')).toEqual({
+      type: 'plain',
+      text: '[9007199254740993, null]',
+    });
+  });
+
+  it('prefixes binary', () => {
+    expect(describeCell('00ff', 'bytes')).toEqual({ type: 'plain', text: '0x00ff' });
+  });
+
+  it('caps what a single-line cell draws', () => {
+    const long = 'x'.repeat(5000) + '   ';
+    const shown = describeCell(long, 'text');
+    expect(shown).toEqual({ type: 'plain', text: 'x'.repeat(DISPLAY_CHARS) });
+  });
+
+  it('measures the display length for auto-fit', () => {
+    expect(displayLength(null, 'int', 'NULL')).toBe(4);
+    expect(displayLength('abcd', 'bytes', 'NULL')).toBe(6);
+    expect(displayLength('[{"kind":"text","value":"a"}]', 'array', 'NULL')).toBe(5);
+    expect(displayLength('x'.repeat(9000), 'text', 'NULL')).toBe(DISPLAY_CHARS);
+  });
+
+  it('knows the numeric kinds', () => {
+    expect(isNumericKind('int')).toBe(true);
+    expect(isNumericKind('float')).toBe(true);
+    expect(isNumericKind('text')).toBe(false);
+  });
+});
diff --git a/src/features/grid/cellDisplay.ts b/src/features/grid/cellDisplay.ts
new file mode 100644
index 0000000..4dcb005
--- /dev/null
+++ b/src/features/grid/cellDisplay.ts
@@ -0,0 +1,83 @@
+import type { ValueKind } from '../../ipc';
+import { arrayJson } from './cellJson';
+
+/**
+ * How a cell reads on screen (F-060). Values arrive as lossless text and are shown as is
+ * (no rounding, no locale grouping); what the grid adds is making invisible things visible:
+ * `NULL`, the empty string, leading / trailing whitespace and line breaks.
+ */
+
+/** Characters drawn at most per cell: a cell is one line, wider text is cut by the ellipsis. */
+export const DISPLAY_CHARS = 400;
+
+export type CellDisplay =
+  | { type: 'null' }
+  | { type: 'empty' }
+  | { type: 'plain'; text: string }
+  /** Text with marked parts (whitespace shown as symbols), as alternating segments. */
+  | { type: 'marked'; parts: readonly DisplayPart[] };
+
+export interface DisplayPart {
+  text: string;
+  mark: boolean;
+}
+
+const NEEDS_MARKS = /^\s|\s$|[\n\r\t]/;
+
+const SYMBOLS: Record<string, string> = {
+  ' ': '·',
+  '\t': '→',
+  '\n': '↵',
+  '\r': '␍',
+};
+
+function symbolize(whitespace: string): string {
+  let out = '';
+  for (const char of whitespace) out += SYMBOLS[char] ?? '·';
+  return out;
+}
+
+/** Display form of a cell. `kind` decides prefixes (binary is shown as `0x…`). */
+export function describeCell(text: string | null, kind: ValueKind): CellDisplay {
+  if (text === null) return { type: 'null' };
+  if (text === '') return { type: 'empty' };
+  if (kind === 'bytes') return { type: 'plain', text: `0x${text.slice(0, DISPLAY_CHARS)}` };
+  if (kind === 'array') {
+    // Arrays travel as the JSON of their values; show them as plain JSON.
+    const plain = arrayJson(text);
+    if (plain !== null) return { type: 'plain', text: plain.slice(0, DISPLAY_CHARS) };
+  }
+  const shown = text.length > DISPLAY_CHARS ? text.slice(0, DISPLAY_CHARS) : text;
+  if (!NEEDS_MARKS.test(shown)) return { type: 'plain', text: shown };
+
+  const parts: DisplayPart[] = [];
+  const push = (value: string, mark: boolean) => {
+    if (!value) return;
+    const last = parts.at(-1);
+    if (last && last.mark === mark) last.text += value;
+    else parts.push({ text: value, mark });
+  };
+  const leading = /^\s+/.exec(shown)?.[0] ?? '';
+  // Text cut at DISPLAY_CHARS has no visible end: its trailing whitespace is not the value's.
+  const trailing = text.length > DISPLAY_CHARS ? '' : (/\s+$/.exec(shown)?.[0] ?? '');
+  if (leading.length === shown.length) {
+    push(symbolize(shown), true);
+    return { type: 'marked', parts };
+  }
+  push(symbolize(leading), true);
+  const middle = shown.slice(leading.length, shown.length - trailing.length);
+  for (const piece of middle.split(/([\n\r\t]+)/)) {
+    if (/^[\n\r\t]+$/.test(piece)) push(symbolize(piece), true);
+    else push(piece, false);
+  }
+  push(symbolize(trailing), true);
+  return { type: 'marked', parts };
+}
+
+/** Longest line a cell shows, in characters (auto-fit width). */
+export function displayLength(text: string | null, kind: ValueKind, nullLabel: string): number {
+  if (text === null) return nullLabel.length;
+  if (kind === 'bytes') return Math.min(DISPLAY_CHARS, text.length) + 2;
+  if (kind === 'array') return Math.min(DISPLAY_CHARS, (arrayJson(text) ?? text).length);
+  return Math.min(DISPLAY_CHARS, text.length);
+}
diff --git a/src/features/grid/cellJson.ts b/src/features/grid/cellJson.ts
new file mode 100644
index 0000000..6c382a4
--- /dev/null
+++ b/src/features/grid/cellJson.ts
@@ -0,0 +1,57 @@
+import type { Value, ValueKind } from '../../ipc';
+import { stringifyJson, tryParseJson } from './jsonTree';
+
+const NUMERIC: ReadonlySet<ValueKind> = new Set(['int', 'decimal', 'float']);
+
+export function isNumericKind(kind: ValueKind): boolean {
+  return NUMERIC.has(kind);
+}
+
+/** A JSON number literal (what `NaN` or `Infinity` are not). */
+export const JSON_NUMBER = /^-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?$/;
+
+/** A JSON fragment for one value of a `Value[]` (array cells). */
+function jsonOfValue(value: Value): string {
+  switch (value.kind) {
+    case 'null':
+      return 'null';
+    case 'bool':
+      return value.value ? 'true' : 'false';
+    case 'array':
+      return `[${value.value.map(jsonOfValue).join(', ')}]`;
+    default:
+      return jsonOfCell(value.value, value.kind);
+  }
+}
+
+/**
+ * A cell as JSON: numbers stay numbers (as written, never through a double), JSON stays JSON,
+ * arrays become plain JSON arrays, the rest are strings.
+ */
+export function jsonOfCell(text: string | null, kind: ValueKind): string {
+  if (text === null) return 'null';
+  if (isNumericKind(kind)) return JSON_NUMBER.test(text) ? text : JSON.stringify(text);
+  if (kind === 'bool' && (text === 'true' || text === 'false')) return text;
+  if (kind === 'json') {
+    const tree = tryParseJson(text);
+    return tree ? stringifyJson(tree) : JSON.stringify(text);
+  }
+  if (kind === 'array') {
+    const plain = arrayJson(text);
+    if (plain !== null) return plain;
+  }
+  return JSON.stringify(text);
+}
+
+/**
+ * An array cell (the JSON of its `Value[]`, as the backend sends it) as a plain JSON array:
+ * `[{"kind":"text","value":"a"},{"kind":"null"}]` → `["a", null]`. `null` if not that form.
+ */
+export function arrayJson(text: string): string | null {
+  try {
+    const items = JSON.parse(text) as unknown;
+    return Array.isArray(items) ? `[${(items as Value[]).map(jsonOfValue).join(', ')}]` : null;
+  } catch {
+    return null;
+  }
+}
