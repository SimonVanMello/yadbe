+import { describe, expect, it } from 'vitest';
+
+import {
+  formatCopy,
+  formatCsv,
+  formatInList,
+  formatInsert,
+  formatJson,
+  formatMarkdown,
+  formatTsv,
+  quoteIdentifierAnsi,
+  sqlLiteral,
+  type CopyTable,
+} from './copyFormats';
+import { jsonOfCell } from './cellJson';
+
+const table: CopyTable = {
+  columns: [
+    { name: 'id', kind: 'int' },
+    { name: 'name', kind: 'text' },
+    { name: 'total', kind: 'decimal' },
+  ],
+  rows: [
+    [
+      { text: '9007199254740993', kind: 'int' },
+      { text: 'Ana', kind: 'text' },
+      { text: '12345678901234567890.25', kind: 'decimal' },
+    ],
+    [
+      { text: '2', kind: 'int' },
+      { text: null, kind: 'text' },
+      { text: '', kind: 'decimal' },
+    ],
+  ],
+};
+
+const tricky: CopyTable = {
+  columns: [{ name: 'v', kind: 'text' }],
+  rows: [
+    [{ text: 'a\tb', kind: 'text' }],
+    [{ text: 'line 1\nline 2', kind: 'text' }],
+    [{ text: '"quoted"', kind: 'text' }],
+    [{ text: 'it\'s, "x"', kind: 'text' }],
+    [{ text: '  padded ', kind: 'text' }],
+    [{ text: '', kind: 'text' }],
+    [{ text: null, kind: 'text' }],
+    [{ text: 'a|b\\c', kind: 'text' }],
+  ],
+};
+
+describe('TSV', () => {
+  it('writes rows, with or without the header', () => {
+    expect(formatTsv(table, { headers: true })).toBe(
+      'id\tname\ttotal\n9007199254740993\tAna\t12345678901234567890.25\n2\t\t',
+    );
+    expect(formatTsv(table, { headers: false }).split('\n')).toHaveLength(2);
+  });
+
+  it('quotes tabs, line breaks and leading quotes', () => {
+    expect(formatTsv(tricky, { headers: false }).split('\n').slice(0, 5)).toEqual([
+      '"a\tb"',
+      '"line 1',
+      'line 2"',
+      '"""quoted"""',
+      'it\'s, "x"',
+    ]);
+  });
+});
+
+describe('CSV', () => {
+  it('keeps NULL and the empty string distinct', () => {
+    expect(formatCsv(table, { headers: true })).toBe(
+      'id,name,total\n9007199254740993,Ana,12345678901234567890.25\n2,,""',
+    );
+  });
+
+  it('quotes per RFC 4180', () => {
+    expect(formatCsv(tricky, { headers: false })).toBe(
+      [
+        'a\tb',
+        '"line 1\nline 2"',
+        '"""quoted"""',
+        '"it\'s, ""x"""',
+        '"  padded "',
+        '""',
+        '',
+        'a|b\\c',
+      ].join('\n'),
+    );
+  });
+});
+
+describe('JSON', () => {
+  it('writes objects with exact numbers and nulls', () => {
+    expect(formatJson(table, { headers: true })).toBe(
+      '[\n  {"id": 9007199254740993, "name": "Ana", "total": 12345678901234567890.25},\n' +
+        '  {"id": 2, "name": null, "total": ""}\n]',
+    );
+  });
+
+  it('writes arrays without headers', () => {
+    expect(formatJson(table, { headers: false })).toContain('[2, null, ""]');
+    expect(formatJson({ columns: table.columns, rows: [] }, { headers: true })).toBe('[]');
+  });
+
+  it('keeps duplicate column names apart', () => {
+    const dup: CopyTable = {
+      columns: [
+        { name: 'id', kind: 'int' },
+        { name: 'id', kind: 'int' },
+      ],
+      rows: [
+        [
+          { text: '1', kind: 'int' },
+          { text: '2', kind: 'int' },
+        ],
+      ],
+    };
+    expect(formatJson(dup, { headers: true })).toContain('{"id": 1, "id_2": 2}');
+  });
+
+  it('converts each kind', () => {
+    expect(jsonOfCell('NaN', 'float')).toBe('"NaN"');
+    expect(jsonOfCell('-1.5e10', 'float')).toBe('-1.5e10');
+    expect(jsonOfCell('true', 'bool')).toBe('true');
+    expect(jsonOfCell('{"a":1.000000000000000000001}', 'json')).toBe(
+      '{"a": 1.000000000000000000001}',
+    );
+    expect(jsonOfCell('{oops', 'json')).toBe('"{oops"');
+    const array = JSON.stringify([
+      { kind: 'int', value: '9007199254740993' },
+      { kind: 'null' },
+      { kind: 'text', value: 'x' },
+      { kind: 'array', value: [{ kind: 'bool', value: true }] },
+    ]);
+    expect(jsonOfCell(array, 'array')).toBe('[9007199254740993, null, "x", [true]]');
+    expect(jsonOfCell('[1', 'array')).toBe('"[1"');
+    expect(jsonOfCell('deadbeef', 'bytes')).toBe('"deadbeef"');
+    expect(jsonOfCell('2026-01-01', 'date')).toBe('"2026-01-01"');
+  });
+});
+
+describe('Markdown', () => {
+  it('writes a table with numeric columns right-aligned', () => {
+    expect(formatMarkdown(table)).toBe(
+      [
+        '| id | name | total |',
+        '| ---: | --- | ---: |',
+        '| 9007199254740993 | Ana | 12345678901234567890.25 |',
+        '| 2 | NULL |  |',
+      ].join('\n'),
+    );
+  });
+
+  it('escapes pipes, backslashes and line breaks', () => {
+    const out = formatMarkdown(tricky).split('\n');
+    expect(out[3]).toBe('| line 1<br>line 2 |');
+    expect(out[9]).toBe('| a\\|b\\\\c |');
+  });
+});
+
+describe('SQL', () => {
+  it('writes literals per kind', () => {
+    expect(sqlLiteral({ text: null, kind: 'int' })).toBe('NULL');
+    expect(sqlLiteral({ text: '42', kind: 'int' })).toBe('42');
+    expect(sqlLiteral({ text: 'NaN', kind: 'float' })).toBe("'NaN'");
+    expect(sqlLiteral({ text: 'false', kind: 'bool' })).toBe('FALSE');
+    expect(sqlLiteral({ text: '00ff', kind: 'bytes' })).toBe("X'00ff'");
+    expect(sqlLiteral({ text: "O'Brien", kind: 'text' })).toBe("'O''Brien'");
+    expect(sqlLiteral({ text: '', kind: 'text' })).toBe("''");
+  });
+
+  it('quotes identifiers only when needed', () => {
+    expect(quoteIdentifierAnsi('total')).toBe('total');
+    expect(quoteIdentifierAnsi('Total')).toBe('"Total"');
+    expect(quoteIdentifierAnsi('order')).toBe('"order"');
+    expect(quoteIdentifierAnsi('a"b')).toBe('"a""b"');
+  });
+
+  it('writes one INSERT per row', () => {
+    expect(formatInsert(table, { headers: true, tableName: 'orders' })).toBe(
+      "INSERT INTO orders (id, name, total) VALUES (9007199254740993, 'Ana', 12345678901234567890.25);\n" +
+        "INSERT INTO orders (id, name, total) VALUES (2, NULL, '');",
+    );
+    expect(formatInsert(table, { headers: false })).toMatch(/^INSERT INTO table_name VALUES \(/);
+    expect(
+      formatInsert(table, { headers: true, quoteIdentifier: (n) => `[${n}]` }).split('\n')[0],
+    ).toContain('([id], [name], [total])');
+  });
+
+  it('writes an IN list without duplicates', () => {
+    const ids: CopyTable = {
+      columns: [{ name: 'id', kind: 'int' }],
+      rows: [['1'], ['2'], ['1'], [null]].map(([text]) => [{ text: text ?? null, kind: 'int' }]),
+    };
+    expect(formatInList(ids)).toBe('(1, 2, NULL)');
+    expect(formatCopy('inList', tricky, { headers: true })).toMatch(/^\('a\tb', /);
+  });
+});
+
+it('dispatches every format', () => {
+  for (const format of ['tsv', 'csv', 'json', 'markdown', 'insert', 'inList'] as const) {
+    expect(formatCopy(format, table, { headers: true }).length).toBeGreaterThan(0);
+  }
+});
diff --git a/src/features/grid/copyFormats.ts b/src/features/grid/copyFormats.ts
new file mode 100644
index 0000000..b4a96ff
--- /dev/null
+++ b/src/features/grid/copyFormats.ts
@@ -0,0 +1,219 @@
+import type { ValueKind } from '../../ipc';
+import { isNumericKind, JSON_NUMBER, jsonOfCell } from './cellJson';
+
+/**
+ * Text formats of a copied selection (F-063). Pure functions: the cells come in as their
+ * lossless text (`null` for SQL `NULL`) with their kind, and nothing is converted through a
+ * JavaScript number, so 64-bit integers and decimals stay exact.
+ */
+
+export type CopyFormat = 'tsv' | 'csv' | 'json' | 'markdown' | 'insert' | 'inList';
+
+export const COPY_FORMATS: readonly CopyFormat[] = [
+  'tsv',
+  'csv',
+  'json',
+  'markdown',
+  'insert',
+  'inList',
+];
+
+export interface CopyColumn {
+  name: string;
+  kind: ValueKind;
+}
+
+export interface CopyCell {
+  text: string | null;
+  kind: ValueKind;
+}
+
+export interface CopyTable {
+  columns: readonly CopyColumn[];
+  rows: readonly (readonly CopyCell[])[];
+}
+
+export interface CopyOptions {
+  /** Column names first (TSV, CSV, Markdown), objects instead of arrays (JSON), a column list (INSERT). */
+  headers: boolean;
+  /** Target of `INSERT INTO` (the grid does not know which table a result comes from). */
+  tableName?: string;
+  /** Identifier quoting of the connection's dialect; ANSI double quotes by default. */
+  quoteIdentifier?: (name: string) => string;
+}
+
+export const DEFAULT_TABLE_NAME = 'table_name';
+
+export function formatCopy(format: CopyFormat, table: CopyTable, options: CopyOptions): string {
+  switch (format) {
+    case 'tsv':
+      return formatTsv(table, options);
+    case 'csv':
+      return formatCsv(table, options);
+    case 'json':
+      return formatJson(table, options);
+    case 'markdown':
+      return formatMarkdown(table);
+    case 'insert':
+      return formatInsert(table, options);
+    case 'inList':
+      return formatInList(table);
+  }
+}
+
+function lines(table: CopyTable, headers: boolean, cell: (text: string | null) => string): string {
+  const out: string[] = [];
+  if (headers) out.push(table.columns.map((c) => cell(c.name)).join('\t'));
+  for (const row of table.rows) out.push(row.map((c) => cell(c.text)).join('\t'));
+  return out.join('\n');
+}
+
+/**
+ * Tab-separated, the way spreadsheets paste it: `NULL` and the empty string both become an
+ * empty cell; a value with a tab, a line break or a leading quote is quoted (`"` doubled).
+ */
+export function formatTsv(table: CopyTable, options: Pick<CopyOptions, 'headers'>): string {
+  return lines(table, options.headers, (text) => {
+    if (text === null) return '';
+    return /[\t\n\r]|^"/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+  });
+}
+
+/**
+ * RFC 4180 with `\n` line ends. `NULL` is an empty field and the empty string a quoted `""`, so
+ * the two stay distinct; fields with a comma, a quote, a line break or edge spaces are quoted.
+ */
+export function formatCsv(table: CopyTable, options: Pick<CopyOptions, 'headers'>): string {
+  const field = (text: string | null): string => {
+    if (text === null) return '';
+    if (text === '' || /[",\n\r]|^\s|\s$/.test(text)) return `"${text.replace(/"/g, '""')}"`;
+    return text;
+  };
+  const out: string[] = [];
+  if (options.headers) out.push(table.columns.map((c) => field(c.name)).join(','));
+  for (const row of table.rows) out.push(row.map((c) => field(c.text)).join(','));
+  return out.join('\n');
+}
+
+/** Names unique within a row object: a second `id` becomes `id_2`. */
+function uniqueNames(columns: readonly CopyColumn[]): string[] {
+  const seen = new Map<string, number>();
+  return columns.map(({ name }) => {
+    const count = (seen.get(name) ?? 0) + 1;
+    seen.set(name, count);
+    if (count === 1) return name;
+    let candidate = `${name}_${String(count)}`;
+    while (seen.has(candidate)) candidate += '_';
+    seen.set(candidate, 1);
+    return candidate;
+  });
+}
+
+/** An array with one row per line: objects keyed by column name, or arrays without headers. */
+export function formatJson(table: CopyTable, options: Pick<CopyOptions, 'headers'>): string {
+  if (table.rows.length === 0) return '[]';
+  const keys = uniqueNames(table.columns).map((name) => JSON.stringify(name));
+  const rows = table.rows.map((row) =>
+    options.headers
+      ? `{${row.map((cell, i) => `${keys[i] ?? '""'}: ${jsonOfCell(cell.text, cell.kind)}`).join(', ')}}`
+      : `[${row.map((cell) => jsonOfCell(cell.text, cell.kind)).join(', ')}]`,
+  );
+  return `[\n  ${rows.join(',\n  ')}\n]`;
+}
+
+function markdownCell(text: string | null): string {
+  if (text === null) return 'NULL';
+  return text
+    .replace(/\\/g, '\\\\')
+    .replace(/\|/g, '\\|')
+    .replace(/\r?\n|\r/g, '<br>');
+}
+
+/** A GitHub-flavored table (always with its header row, which the format requires). */
+export function formatMarkdown(table: CopyTable): string {
+  const header = `| ${table.columns.map((c) => markdownCell(c.name)).join(' | ')} |`;
+  const rule = `| ${table.columns.map((c) => (isNumericKind(c.kind) ? '---:' : '---')).join(' | ')} |`;
+  const rows = table.rows.map((row) => `| ${row.map((c) => markdownCell(c.text)).join(' | ')} |`);
+  return [header, rule, ...rows].join('\n');
+}
+
+/** ANSI quoting, skipped for plain lowercase names. */
+export function quoteIdentifierAnsi(name: string): string {
+  return /^[a-z_][a-z0-9_]*$/.test(name) && !SQL_RESERVED.has(name)
+    ? name
+    : `"${name.replace(/"/g, '""')}"`;
+}
+
+const SQL_RESERVED = new Set([
+  'all',
+  'and',
+  'as',
+  'by',
+  'case',
+  'check',
+  'column',
+  'constraint',
+  'create',
+  'default',
+  'delete',
+  'desc',
+  'distinct',
+  'end',
+  'from',
+  'group',
+  'having',
+  'in',
+  'index',
+  'insert',
+  'into',
+  'is',
+  'join',
+  'key',
+  'limit',
+  'not',
+  'null',
+  'on',
+  'or',
+  'order',
+  'primary',
+  'references',
+  'select',
+  'table',
+  'to',
+  'union',
+  'unique',
+  'update',
+  'user',
+  'values',
+  'where',
+]);
+
+/**
+ * A SQL literal for a cell. Copied text is meant to be read and edited, not run by yadbe, so it
+ * is written out (this is not SQL yadbe executes: rule 2 binds the values of what it runs).
+ */
+export function sqlLiteral(cell: CopyCell): string {
+  const { text, kind } = cell;
+  if (text === null) return 'NULL';
+  if (isNumericKind(kind) && JSON_NUMBER.test(text)) return text;
+  if (kind === 'bool' && (text === 'true' || text === 'false')) return text.toUpperCase();
+  if (kind === 'bytes' && /^[0-9a-fA-F]*$/.test(text)) return `X'${text}'`;
+  return `'${text.replace(/'/g, "''")}'`;
+}
+
+/** One `INSERT` per row; the column list when `headers` is set. */
+export function formatInsert(table: CopyTable, options: CopyOptions): string {
+  const quote = options.quoteIdentifier ?? quoteIdentifierAnsi;
+  const target = options.tableName ?? DEFAULT_TABLE_NAME;
+  const columns = options.headers ? ` (${table.columns.map((c) => quote(c.name)).join(', ')})` : '';
+  return table.rows
+    .map((row) => `INSERT INTO ${target}${columns} VALUES (${row.map(sqlLiteral).join(', ')});`)
+    .join('\n');
+}
+
+/** `(a, b, c)` of the selected values, row by row, without duplicates. */
+export function formatInList(table: CopyTable): string {
+  const seen = new Set<string>();
+  for (const row of table.rows) for (const cell of row) seen.add(sqlLiteral(cell));
+  return `(${[...seen].join(', ')})`;
+}
