+import { describe, expect, it } from 'vitest';
+
+import { GridBody, type BodyFrame, type BodyLayout } from './gridBody';
+import { columnLefts } from './gridMath';
+import type { RowBlock, RowSource } from './rowSource';
+import { cellSelection, extendTo } from './selection';
+
+const COLS = 4;
+
+function block(offset: number, count: number): RowBlock {
+  const rows = Array.from({ length: count }, (_, i) => offset + i);
+  return {
+    offset,
+    rowCount: count,
+    columns: [
+      { values: rows.map(String), kinds: null, truncated: [] },
+      { values: rows.map((r) => (r % 2 ? null : '')), kinds: null, truncated: [] },
+      { values: rows.map((r) => ` x${String(r)}`), kinds: null, truncated: [0] },
+      { values: rows.map((r) => `c${String(r)}`), kinds: null, truncated: [] },
+    ],
+  };
+}
+
+function setup(loaded: number) {
+  const blocks = new Map<number, RowBlock>();
+  const source: RowSource = {
+    columns: [
+      { name: 'id', typeName: 'int8', kind: 'int' },
+      { name: 'maybe', typeName: 'text', kind: 'text' },
+      { name: 'padded', typeName: 'text', kind: 'text' },
+      { name: 'other', typeName: 'text', kind: 'text' },
+    ],
+    rowCount: 1000,
+    block: (row) => (row < loaded ? (blocks.get(0) ?? undefined) : undefined),
+    request: () => undefined,
+    subscribe: () => () => undefined,
+    read: () => Promise.resolve([]),
+    fullValue: () => Promise.resolve({ kind: 'null' }),
+    loaded: () => blocks.values(),
+  };
+  blocks.set(0, block(0, Math.max(loaded, 1)));
+  const grid = document.createElement('div');
+  const container = document.createElement('div');
+  const gutters = document.createElement('div');
+  grid.append(gutters, container);
+  const body = new GridBody({
+    container,
+    gutters,
+    grid,
+    source,
+    focusId: 'g-focus',
+    classes: {
+      row: 'row',
+      gutter: 'gutter',
+      cell: 'cell',
+      num: 'num',
+      null: 'null',
+      empty: 'empty',
+      mark: 'mark',
+    },
+    labels: { null: 'NULL', empty: 'empty' },
+  });
+  const layout: BodyLayout = {
+    order: [0, 1, 2, 3],
+    lefts: columnLefts([50, 60, 70, 80]),
+    gutterWidth: 40,
+    rowHeight: 20,
+  };
+  const frame = (over: Partial<BodyFrame> = {}): BodyFrame => ({
+    rows: { start: 0, end: 10 },
+    cols: { start: 0, end: COLS },
+    shift: 0,
+    layout,
+    selection: null,
+    ...over,
+  });
+  const rowEl = (row: number) =>
+    container.querySelector<HTMLElement>(`[aria-rowindex="${String(row + 2)}"]:not([hidden])`);
+  const cellEl = (row: number, col: number) =>
+    rowEl(row)?.querySelector<HTMLElement>(`[aria-colindex="${String(col + 1)}"]:not([hidden])`);
+  return { body, grid, container, gutters, frame, rowEl, cellEl, layout };
+}
+
+describe('GridBody', () => {
+  it('draws the visible rows with ARIA indices and typed rendering', () => {
+    const { body, frame, rowEl, cellEl, gutters } = setup(100);
+    body.render(frame());
+    expect(body.renderedRows).toBe(10);
+    expect(rowEl(0)?.style.transform).toBe('translateY(0px)');
+    expect(rowEl(3)?.style.transform).toBe('translateY(60px)');
+    expect(cellEl(0, 0)?.textContent).toBe('0');
+    expect(cellEl(0, 0)?.className).toBe('cell num');
+    expect(cellEl(0, 0)?.style.left).toBe('40px');
+    expect(cellEl(0, 1)?.textContent).toBe('empty');
+    expect(cellEl(1, 1)?.textContent).toBe('NULL');
+    expect(cellEl(1, 1)?.className).toContain('null');
+    expect(cellEl(0, 2)?.querySelector('.mark')?.textContent).toBe('·');
+    expect(cellEl(0, 2)?.hasAttribute('data-truncated')).toBe(true);
+    expect(cellEl(1, 2)?.hasAttribute('data-truncated')).toBe(false);
+    expect(gutters.children[3]?.textContent).toBe('4');
+  });
+
+  it('recycles rows and cells instead of creating new ones', () => {
+    const { body, frame, container, rowEl, cellEl } = setup(100);
+    body.render(frame());
+    const elements = container.querySelectorAll('*').length;
+    body.render(frame({ rows: { start: 5, end: 15 }, cols: { start: 1, end: 3 } }));
+    expect(container.querySelectorAll('*').length).toBe(elements);
+    expect(rowEl(0)).toBeNull();
+    expect(cellEl(14, 1)?.textContent).toBe('empty');
+    expect(cellEl(14, 0)).toBeFalsy();
+    expect(body.renderedRows).toBe(10);
+  });
+
+  it('marks loading rows, then fills them when their block arrives', () => {
+    const { body, frame, rowEl } = setup(0);
+    body.render(frame({ rows: { start: 0, end: 2 } }));
+    expect(rowEl(1)?.hasAttribute('data-loading')).toBe(true);
+  });
+
+  it('shows the selection and the focus, and names the focused cell', () => {
+    const { body, frame, cellEl, grid } = setup(100);
+    const selection = extendTo(cellSelection({ row: 1, col: 1 }), { row: 2, col: 2 });
+    body.render(frame({ selection }));
+    expect(cellEl(1, 1)?.getAttribute('aria-selected')).toBe('true');
+    expect(cellEl(3, 1)?.getAttribute('aria-selected')).toBe('false');
+    expect(cellEl(2, 2)?.hasAttribute('data-focused')).toBe(true);
+    expect(cellEl(2, 2)?.id).toBe('g-focus');
+    expect(grid.getAttribute('aria-activedescendant')).toBe('g-focus');
+    // Scrolled away: no element claims the focus.
+    body.render(frame({ rows: { start: 50, end: 60 }, selection }));
+    expect(grid.hasAttribute('aria-activedescendant')).toBe(false);
+    expect(grid.querySelectorAll('[data-focused]')).toHaveLength(0);
+  });
+
+  it('places rows relative to the scaled scroll position', () => {
+    const { body, frame, rowEl } = setup(100);
+    body.render(frame({ rows: { start: 20, end: 25 }, shift: 300 }));
+    expect(rowEl(20)?.style.transform).toBe('translateY(100px)');
+  });
+
+  it('follows a column move', () => {
+    const { body, frame, cellEl, layout } = setup(100);
+    body.render(frame());
+    const moved = { ...layout, order: [3, 0, 1, 2], lefts: columnLefts([80, 50, 60, 70]) };
+    body.render(frame({ layout: moved }));
+    expect(cellEl(0, 0)?.textContent).toBe('c0');
+    expect(cellEl(0, 1)?.textContent).toBe('0');
+    expect(cellEl(0, 1)?.style.left).toBe('120px');
+  });
+});
diff --git a/src/features/grid/gridBody.ts b/src/features/grid/gridBody.ts
new file mode 100644
index 0000000..786ae38
--- /dev/null
+++ b/src/features/grid/gridBody.ts
@@ -0,0 +1,377 @@
+import type { ValueKind } from '../../ipc';
+import { describeCell } from './cellDisplay';
+import { isNumericKind } from './cellJson';
+import type { Range } from './gridMath';
+import type { RowBlock, RowSource } from './rowSource';
+import { isCellSelected, rowTouched, type Selection } from './selection';
+
+/**
+ * The rows area of the grid, drawn imperatively: a scroll frame never goes through React.
+ * Row and cell elements are recycled (a row leaving the viewport is reused for the one
+ * entering), each write is skipped when the element already shows it, and rows are placed with
+ * a transform. Only visible rows × visible columns (plus a small overscan) exist in the DOM.
+ */
+
+export interface BodyLayout {
+  /** Display index → data column. */
+  order: readonly number[];
+  /** x of each display column after the gutter; `lefts[n]` is the columns' total width. */
+  lefts: Float64Array;
+  gutterWidth: number;
+  rowHeight: number;
+}
+
+export interface BodyFrame {
+  rows: Range;
+  /** Display columns. */
+  cols: Range;
+  /** A row's y in the rows area is `row * rowHeight - shift` (non-zero past the height cap). */
+  shift: number;
+  layout: BodyLayout;
+  selection: Selection | null;
+}
+
+export interface BodyClasses {
+  row: string;
+  gutter: string;
+  cell: string;
+  num: string;
+  null: string;
+  empty: string;
+  mark: string;
+}
+
+export interface BodyLabels {
+  null: string;
+  empty: string;
+}
+
+interface CellView {
+  el: HTMLDivElement;
+  /** Display column. */
+  col: number;
+  dataCol: number;
+  left: number;
+  width: number;
+  /** What the element shows: `undefined` before it shows a loaded value. */
+  text: string | null | undefined;
+  kind: ValueKind | null;
+  truncated: boolean;
+  selected: boolean | null;
+  focused: boolean;
+}
+
+interface RowView {
+  el: HTMLDivElement;
+  gutter: HTMLDivElement;
+  row: number;
+  y: number;
+  width: number;
+  block: RowBlock | undefined | null;
+  loading: boolean | null;
+  touched: boolean | null;
+  layout: BodyLayout | null;
+  cells: Map<number, CellView>;
+  spare: CellView[];
+}
+
+export class GridBody {
+  private readonly container: HTMLElement;
+  private readonly gutters: HTMLElement;
+  private readonly grid: HTMLElement;
+  private readonly source: RowSource;
+  private readonly classes: BodyClasses;
+  private readonly focusId: string;
+  private labels: BodyLabels;
+  private readonly active = new Map<number, RowView>();
+  private readonly spare: RowView[] = [];
+  private focusEl: HTMLElement | null = null;
+
+  constructor(options: {
+    container: HTMLElement;
+    /**
+     * Holds the row numbers: one sticky layer for the whole gutter (a sticky cell per row
+     * costs a compositing layer each).
+     */
+    gutters: HTMLElement;
+    grid: HTMLElement;
+    source: RowSource;
+    classes: BodyClasses;
+    labels: BodyLabels;
+    focusId: string;
+  }) {
+    this.container = options.container;
+    this.gutters = options.gutters;
+    this.grid = options.grid;
+    this.source = options.source;
+    this.classes = options.classes;
+    this.labels = options.labels;
+    this.focusId = options.focusId;
+  }
+
+  setLabels(labels: BodyLabels): void {
+    if (labels.null === this.labels.null && labels.empty === this.labels.empty) return;
+    this.labels = labels;
+    // Repaint the NULL / empty markers in the new language.
+    for (const view of this.active.values()) view.block = null;
+  }
+
+  /** Rows currently in the DOM (for tests and measurements). */
+  get renderedRows(): number {
+    return this.active.size;
+  }
+
+  render(frame: BodyFrame): void {
+    const { rows } = frame;
+    for (const [row, view] of this.active) {
+      if (row < rows.start || row >= rows.end) {
+        this.active.delete(row);
+        for (const cell of view.cells.values()) this.unfocus(cell);
+        this.spare.push(view);
+      }
+    }
+    let focusEl: HTMLElement | null = null;
+    for (let row = rows.start; row < rows.end; row++) {
+      let view = this.active.get(row);
+      if (!view) {
+        view = this.spare.pop() ?? this.createRow();
+        if (view.el.hidden) {
+          view.el.hidden = false;
+          view.gutter.hidden = false;
+        }
+        view.row = row;
+        view.block = null;
+        view.gutter.textContent = String(row + 1);
+        view.el.setAttribute('aria-rowindex', String(row + 2));
+        this.active.set(row, view);
+      }
+      const found = this.renderRow(view, frame);
+      if (found) focusEl = found;
+    }
+    for (const view of this.spare) {
+      if (!view.el.hidden) {
+        view.el.hidden = true;
+        view.gutter.hidden = true;
+      }
+    }
+    this.setFocus(focusEl);
+  }
+
+  destroy(): void {
+    this.active.clear();
+    this.spare.length = 0;
+    this.container.replaceChildren();
+    this.gutters.replaceChildren();
+    this.setFocus(null);
+  }
+
+  private createRow(): RowView {
+    const el = document.createElement('div');
+    el.className = this.classes.row;
+    el.setAttribute('role', 'row');
+    const gutter = document.createElement('div');
+    gutter.className = this.classes.gutter;
+    this.gutters.appendChild(gutter);
+    this.container.appendChild(el);
+    return {
+      el,
+      gutter,
+      row: -1,
+      y: NaN,
+      width: NaN,
+      block: null,
+      loading: null,
+      touched: null,
+      layout: null,
+      cells: new Map(),
+      spare: [],
+    };
+  }
+
+  /** Returns the focused cell's element when this row holds it. */
+  private renderRow(view: RowView, frame: BodyFrame): HTMLElement | null {
+    const { layout, cols, selection } = frame;
+    const { rowHeight, lefts, gutterWidth, order } = layout;
+    const y = view.row * rowHeight - frame.shift;
+    if (y !== view.y) {
+      view.y = y;
+      const transform = `translateY(${String(y)}px)`;
+      view.el.style.transform = transform;
+      view.gutter.style.transform = transform;
+    }
+    const width = gutterWidth + (lefts[lefts.length - 1] ?? 0);
+    if (width !== view.width) {
+      view.width = width;
+      view.el.style.width = `${String(width)}px`;
+    }
+
+    const block = this.source.block(view.row);
+    const dataChanged = block !== view.block;
+    const layoutChanged = layout !== view.layout;
+    view.block = block;
+    view.layout = layout;
+    const loading = !block;
+    if (loading !== view.loading) {
+      view.loading = loading;
+      view.el.toggleAttribute('data-loading', loading);
+    }
+    const touched = rowTouched(selection, view.row);
+    if (touched !== view.touched) {
+      view.touched = touched;
+      view.gutter.toggleAttribute('data-touched', touched);
+    }
+
+    for (const [col, cell] of view.cells) {
+      if (col < cols.start || col >= cols.end) {
+        view.cells.delete(col);
+        this.unfocus(cell);
+        cell.el.hidden = true;
+        view.spare.push(cell);
+      }
+    }
+
+    const index = block ? view.row - block.offset : 0;
+    const focus = selection?.focus;
+    let focusEl: HTMLElement | null = null;
+    for (let col = cols.start; col < cols.end; col++) {
+      let cell = view.cells.get(col);
+      let fresh = false;
+      if (!cell) {
+        cell = view.spare.pop() ?? this.createCell(view);
+        if (cell.el.hidden) cell.el.hidden = false;
+        cell.col = col;
+        cell.el.setAttribute('aria-colindex', String(col + 1));
+        view.cells.set(col, cell);
+        fresh = true;
+      }
+      if (fresh || layoutChanged) {
+        const left = gutterWidth + (lefts[col] ?? 0);
+        const cellWidth = (lefts[col + 1] ?? 0) - (lefts[col] ?? 0);
+        if (left !== cell.left) {
+          cell.left = left;
+          cell.el.style.left = `${String(left)}px`;
+        }
+        if (cellWidth !== cell.width) {
+          cell.width = cellWidth;
+          cell.el.style.width = `${String(cellWidth)}px`;
+        }
+        const dataCol = order[col] ?? col;
+        if (dataCol !== cell.dataCol) {
+          cell.dataCol = dataCol;
+          cell.text = undefined;
+          cell.kind = null;
+        }
+      }
+      if (fresh || dataChanged || layoutChanged) this.paintCell(cell, block, index);
+
+      const selected = isCellSelected(selection, view.row, col);
+      if (selected !== cell.selected) {
+        cell.selected = selected;
+        cell.el.setAttribute('aria-selected', selected ? 'true' : 'false');
+      }
+      const focused = !!focus && focus.row === view.row && focus.col === col;
+      if (focused !== cell.focused) {
+        cell.focused = focused;
+        cell.el.toggleAttribute('data-focused', focused);
+      }
+      if (focused) focusEl = cell.el;
+    }
+    return focusEl;
+  }
+
+  private createCell(view: RowView): CellView {
+    const el = document.createElement('div');
+    el.className = this.classes.cell;
+    el.setAttribute('role', 'gridcell');
+    view.el.appendChild(el);
+    return {
+      el,
+      col: -1,
+      dataCol: -1,
+      left: NaN,
+      width: NaN,
+      text: undefined,
+      kind: null,
+      truncated: false,
+      selected: null,
+      focused: false,
+    };
+  }
+
+  private paintCell(cell: CellView, block: RowBlock | undefined, index: number): void {
+    const { el } = cell;
+    if (!block) {
+      if (cell.text !== undefined || cell.kind !== null) {
+        cell.text = undefined;
+        cell.kind = null;
+        el.className = this.classes.cell;
+        el.textContent = '';
+      }
+      if (cell.truncated) {
+        cell.truncated = false;
+        el.removeAttribute('data-truncated');
+      }
+      return;
+    }
+    const column = block.columns[cell.dataCol];
+    const columnKind = this.source.columns[cell.dataCol]?.kind ?? 'text';
+    const text = column?.values[index] ?? null;
+    const kind = column?.kinds ? (column.kinds[index] ?? columnKind) : columnKind;
+    const truncated = !!column && column.truncated.length > 0 && column.truncated.includes(index);
+    if (truncated !== cell.truncated) {
+      cell.truncated = truncated;
+      el.toggleAttribute('data-truncated', truncated);
+    }
+    if (text === cell.text && kind === cell.kind) return;
+    cell.text = text;
+    cell.kind = kind;
+    const { classes } = this;
+    const display = describeCell(text, kind);
+    const base = isNumericKind(kind) ? `${classes.cell} ${classes.num}` : classes.cell;
+    switch (display.type) {
+      case 'null':
+        el.className = `${base} ${classes.null}`;
+        el.textContent = this.labels.null;
+        return;
+      case 'empty':
+        el.className = `${base} ${classes.empty}`;
+        el.textContent = this.labels.empty;
+        return;
+      case 'plain':
+        el.className = base;
+        el.textContent = display.text;
+        return;
+      case 'marked': {
+        el.className = base;
+        const nodes = display.parts.map((part) => {
+          if (!part.mark) return document.createTextNode(part.text);
+          const span = document.createElement('span');
+          span.className = classes.mark;
+          span.textContent = part.text;
+          return span;
+        });
+        el.replaceChildren(...nodes);
+        return;
+      }
+    }
+  }
+
+  /** A recycled cell must not keep the focus mark of the cell it showed. */
+  private unfocus(cell: CellView): void {
+    if (!cell.focused) return;
+    cell.focused = false;
+    cell.el.removeAttribute('data-focused');
+  }
+
+  private setFocus(el: HTMLElement | null): void {
+    if (el === this.focusEl) return;
+    if (this.focusEl?.id === this.focusId) this.focusEl.removeAttribute('id');
+    this.focusEl = el;
+    if (el) {
+      el.id = this.focusId;
+      this.grid.setAttribute('aria-activedescendant', this.focusId);
+    } else {
+      this.grid.removeAttribute('aria-activedescendant');
+    }
+  }
+}
