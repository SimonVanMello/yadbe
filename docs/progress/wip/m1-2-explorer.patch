+++ b/src/features/explorer/explorerStore.test.ts
@@ -0,0 +1,74 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { nodeKeys } from './explorerRows';
+import { createExplorerStore, ROOT_NODE } from './explorerStore';
+
+let store: ReturnType<typeof createExplorerStore>;
+const state = () => store.getState();
+const open = (connectionId: string) => [...(state().expanded[connectionId] ?? [])];
+
+beforeEach(() => {
+  store = createExplorerStore();
+});
+
+describe('expanded nodes', () => {
+  it('remembers the open nodes of each connection apart', () => {
+    state().setExpanded('a', nodeKeys.database('shop'), true);
+    state().setExpanded('b', nodeKeys.database('crm'), true);
+    expect(open('a')).toEqual([nodeKeys.database('shop')]);
+    expect(open('b')).toEqual([nodeKeys.database('crm')]);
+  });
+
+  it('toggles a node', () => {
+    const node = nodeKeys.schema('shop', 'public');
+    state().toggle('a', node);
+    expect(open('a')).toEqual([node]);
+    state().toggle('a', node);
+    expect(open('a')).toEqual([]);
+  });
+
+  it('keeps the same object when nothing changes, so nothing re-renders', () => {
+    state().setExpanded('a', nodeKeys.database('shop'), true);
+    const before = state().expanded;
+    state().setExpanded('a', nodeKeys.database('shop'), true);
+    state().setExpanded('a', nodeKeys.database('other'), false);
+    expect(state().expanded).toBe(before);
+  });
+});
+
+describe('first connection', () => {
+  it('opens the connection once, then the current database once', () => {
+    expect(state().seed('a')).toBe(true);
+    expect(open('a')).toEqual([ROOT_NODE]);
+    state().seedDatabase('a', nodeKeys.database('shop'));
+    expect(open('a')).toEqual([ROOT_NODE, nodeKeys.database('shop')]);
+    // The user closes both: a reconnection does not open them again.
+    state().setExpanded('a', ROOT_NODE, false);
+    state().setExpanded('a', nodeKeys.database('shop'), false);
+    expect(state().seed('a')).toBe(false);
+    state().seedDatabase('a', nodeKeys.database('shop'));
+    expect(open('a')).toEqual([]);
+  });
+
+  it('does not open a database of a connection that was not seeded', () => {
+    state().seedDatabase('a', nodeKeys.database('shop'));
+    expect(open('a')).toEqual([]);
+  });
+});
+
+describe('system objects and forgetting', () => {
+  it('hides system objects until asked', () => {
+    expect(state().showSystem).toBe(false);
+    state().setShowSystem(true);
+    expect(state().showSystem).toBe(true);
+  });
+
+  it('forgets a connection', () => {
+    state().seed('a');
+    state().seed('b');
+    state().forget('a');
+    expect(state().expanded['a']).toBeUndefined();
+    expect(state().seed('a')).toBe(true);
+    expect(open('b')).toEqual([ROOT_NODE]);
+  });
+});
diff --git a/src/features/explorer/explorerStore.ts b/src/features/explorer/explorerStore.ts
new file mode 100644
index 0000000..b50de7e
--- /dev/null
+++ b/src/features/explorer/explorerStore.ts
@@ -0,0 +1,84 @@
+import { create } from 'zustand';
+
+/** Node key of the connection row itself, in its own expanded set. */
+export const ROOT_NODE = '["c"]';
+
+interface ExplorerStore {
+  /** Expanded nodes per connection (node keys of `explorerRows.ts`), remembered for the session. */
+  expanded: Readonly<Record<string, ReadonlySet<string>>>;
+  /**
+   * Connections opened once: the first time, the tree opens down to the current database
+   * (`root`: the connection row is open, `database`: the database too).
+   */
+  seeded: Readonly<Record<string, 'root' | 'database'>>;
+  /** System databases, schemas and objects are hidden by default (F-027). */
+  showSystem: boolean;
+  setExpanded: (connectionId: string, node: string, expanded: boolean) => void;
+  toggle: (connectionId: string, node: string) => void;
+  /** Opens the connection row once, the first time it connects. Returns whether it did. */
+  seed: (connectionId: string) => boolean;
+  /** Opens the current database node once, when the first seed knows its name. */
+  seedDatabase: (connectionId: string, databaseNode: string) => void;
+  setShowSystem: (show: boolean) => void;
+  forget: (connectionId: string) => void;
+}
+
+function withNode(
+  current: ReadonlySet<string> | undefined,
+  node: string,
+  expanded: boolean,
+): ReadonlySet<string> {
+  const next = new Set(current);
+  if (expanded) next.add(node);
+  else next.delete(node);
+  return next;
+}
+
+export function createExplorerStore() {
+  return create<ExplorerStore>()((set, get) => ({
+    expanded: {},
+    seeded: {},
+    showSystem: false,
+    setExpanded: (connectionId, node, expanded) => {
+      const current = get().expanded[connectionId];
+      if ((current?.has(node) ?? false) === expanded) return;
+      set((state) => ({
+        expanded: { ...state.expanded, [connectionId]: withNode(current, node, expanded) },
+      }));
+    },
+    toggle: (connectionId, node) => {
+      get().setExpanded(connectionId, node, !(get().expanded[connectionId]?.has(node) ?? false));
+    },
+    seed: (connectionId) => {
+      if (get().seeded[connectionId]) return false;
+      set((state) => ({
+        seeded: { ...state.seeded, [connectionId]: 'root' },
+        expanded: {
+          ...state.expanded,
+          [connectionId]: withNode(state.expanded[connectionId], ROOT_NODE, true),
+        },
+      }));
+      return true;
+    },
+    seedDatabase: (connectionId, databaseNode) => {
+      if (get().seeded[connectionId] !== 'root') return;
+      set((state) => ({
+        seeded: { ...state.seeded, [connectionId]: 'database' },
+        expanded: {
+          ...state.expanded,
+          [connectionId]: withNode(state.expanded[connectionId], databaseNode, true),
+        },
+      }));
+    },
+    setShowSystem: (showSystem) => {
+      set({ showSystem });
+    },
+    forget: (connectionId) => {
+      const without = <T>(record: Readonly<Record<string, T>>) =>
+        Object.fromEntries(Object.entries(record).filter(([id]) => id !== connectionId));
+      set((state) => ({ expanded: without(state.expanded), seeded: without(state.seeded) }));
+    },
+  }));
+}
+
+export const useExplorerStore = createExplorerStore();
diff --git a/src/features/explorer/metaApi.ts b/src/features/explorer/metaApi.ts
new file mode 100644
index 0000000..989bd2a
--- /dev/null
+++ b/src/features/explorer/metaApi.ts
@@ -0,0 +1,43 @@
+import { ipc, unwrap, type IpcResult } from '../../ipc';
+import type { MetaRequest } from './metaKeys';
+
+let counter = 0;
+
+/**
+ * Runs a metadata read that the backend can stop: aborting `signal` (the query lost its last
+ * observer, e.g. the node was collapsed while loading) cancels the read on the server.
+ */
+async function read<T>(signal: AbortSignal, call: (requestId: string) => Promise<IpcResult<T>>) {
+  counter += 1;
+  const requestId = `explorer-${Date.now().toString(36)}-${counter.toString(36)}`;
+  const cancel = () => {
+    void ipc.commands.cancelMetaRequest(requestId).catch(() => undefined);
+  };
+  signal.addEventListener('abort', cancel, { once: true });
+  try {
+    return await unwrap(call(requestId));
+  } finally {
+    signal.removeEventListener('abort', cancel);
+  }
+}
+
+/** Reads one node of the explorer. Rejects with a `YadbeIpcError`. */
+export function fetchMeta(connectionId: string, request: MetaRequest, signal: AbortSignal) {
+  const { commands } = ipc;
+  switch (request.type) {
+    case 'databases':
+      return read(signal, (id) => commands.listDatabases(id, connectionId));
+    case 'schemas':
+      return read(signal, (id) => commands.listSchemas(id, connectionId, request.database));
+    case 'counts':
+      return read(signal, (id) =>
+        commands.listObjectCounts(id, connectionId, request.database, request.schema),
+      );
+    case 'objects':
+      return read(signal, (id) =>
+        commands.listObjects(id, connectionId, request.database, request.schema, request.kind),
+      );
+    case 'table':
+      return read(signal, (id) => commands.getTableDetails(id, connectionId, request.table));
+  }
+}
