index 0000000..1ecbf6f
--- /dev/null
+++ b/src/features/explorer/metaKeys.test.ts
@@ -0,0 +1,75 @@
+import { QueryClient } from '@tanstack/react-query';
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import type { MetaNode, ObjectRef } from '../../ipc';
+import { invalidationFilters, metaKeys } from './metaKeys';
+
+const ORDERS: ObjectRef = { database: 'app', schema: 'shop', name: 'orders' };
+const CUSTOMERS: ObjectRef = { database: 'app', schema: 'shop', name: 'customers' };
+
+let client: QueryClient;
+
+/** Name of each cached query, to compare what a refresh makes stale. */
+const keys = {
+  databases: metaKeys.databases('c1'),
+  schemas: metaKeys.schemas('c1', 'app'),
+  counts: metaKeys.counts('c1', 'app', 'shop'),
+  tables: metaKeys.objects('c1', 'app', 'shop', 'table'),
+  views: metaKeys.objects('c1', 'app', 'shop', 'view'),
+  orders: metaKeys.table('c1', ORDERS, 'table'),
+  customers: metaKeys.table('c1', CUSTOMERS, 'table'),
+  salesCounts: metaKeys.counts('c1', 'app', 'sales'),
+  otherDatabase: metaKeys.schemas('c1', 'archive'),
+  otherConnection: metaKeys.databases('c2'),
+};
+
+beforeEach(() => {
+  client = new QueryClient();
+  for (const key of Object.values(keys)) client.setQueryData([...key], 'data');
+});
+
+async function stale(node: MetaNode, connectionId = 'c1'): Promise<string[]> {
+  await Promise.all(
+    invalidationFilters(connectionId, node).map((filters) => client.invalidateQueries(filters)),
+  );
+  return Object.entries(keys)
+    .filter(([, key]) => client.getQueryState([...key])?.isInvalidated)
+    .map(([name]) => name);
+}
+
+describe('invalidating by node', () => {
+  it('drops the whole connection and nothing of another', async () => {
+    const dropped = await stale({ level: 'connection' });
+    expect(dropped).not.toContain('otherConnection');
+    expect(dropped).toHaveLength(Object.keys(keys).length - 1);
+  });
+
+  it('drops a database with its schemas, and no other database', async () => {
+    const dropped = await stale({ level: 'database', database: 'app' });
+    expect(dropped).toEqual(
+      expect.arrayContaining(['schemas', 'counts', 'tables', 'orders', 'salesCounts']),
+    );
+    expect(dropped).not.toContain('databases');
+    expect(dropped).not.toContain('otherDatabase');
+  });
+
+  it('drops a schema with what is in it, but not the list of schemas', async () => {
+    const dropped = await stale({ level: 'schema', database: 'app', schema: 'shop' });
+    expect(dropped.sort()).toEqual(['counts', 'customers', 'orders', 'tables', 'views']);
+  });
+
+  it('drops one kind of object, the counts and the details of those objects', async () => {
+    const dropped = await stale({
+      level: 'objects',
+      database: 'app',
+      schema: 'shop',
+      kind: 'table',
+    });
+    expect(dropped.sort()).toEqual(['counts', 'customers', 'orders', 'tables']);
+  });
+
+  it('drops one table whatever its kind', async () => {
+    const dropped = await stale({ level: 'table', table: ORDERS });
+    expect(dropped).toEqual(['orders']);
+  });
+});
diff --git a/src/features/explorer/metaKeys.ts b/src/features/explorer/metaKeys.ts
new file mode 100644
index 0000000..c08bb15
--- /dev/null
+++ b/src/features/explorer/metaKeys.ts
@@ -0,0 +1,99 @@
+import type { InvalidateQueryFilters } from '@tanstack/react-query';
+
+import type { MetaNode, ObjectKind, ObjectRef } from '../../ipc';
+
+/** What the explorer asks the backend, one request per node that lists its children. */
+export type MetaRequest =
+  | { type: 'databases' }
+  | { type: 'schemas'; database: string }
+  | { type: 'counts'; database: string; schema: string | null }
+  | { type: 'objects'; database: string; schema: string | null; kind: ObjectKind }
+  | { type: 'table'; table: ObjectRef; kind: ObjectKind };
+
+type Key = readonly (string | null)[];
+
+/**
+ * Query keys nest like the backend's `MetaCache`, so that a `meta-refreshed` node maps to one
+ * key prefix: `['meta', connection, 'db', database, 'schema', schema, …]`.
+ */
+export const metaKeys = {
+  connection: (connectionId: string): Key => ['meta', connectionId],
+  databases: (connectionId: string): Key => ['meta', connectionId, 'databases'],
+  database: (connectionId: string, database: string): Key => ['meta', connectionId, 'db', database],
+  schemas: (connectionId: string, database: string): Key => [
+    ...metaKeys.database(connectionId, database),
+    'schemas',
+  ],
+  schema: (connectionId: string, database: string, schema: string | null): Key => [
+    ...metaKeys.database(connectionId, database),
+    'schema',
+    schema,
+  ],
+  counts: (connectionId: string, database: string, schema: string | null): Key => [
+    ...metaKeys.schema(connectionId, database, schema),
+    'counts',
+  ],
+  objects: (
+    connectionId: string,
+    database: string,
+    schema: string | null,
+    kind: ObjectKind,
+  ): Key => [...metaKeys.schema(connectionId, database, schema), 'objects', kind],
+  table: (connectionId: string, table: ObjectRef, kind: ObjectKind): Key => [
+    ...metaKeys.schema(connectionId, table.database, table.schema),
+    'table',
+    kind,
+    table.name,
+  ],
+};
+
+export function requestKey(connectionId: string, request: MetaRequest): Key {
+  switch (request.type) {
+    case 'databases':
+      return metaKeys.databases(connectionId);
+    case 'schemas':
+      return metaKeys.schemas(connectionId, request.database);
+    case 'counts':
+      return metaKeys.counts(connectionId, request.database, request.schema);
+    case 'objects':
+      return metaKeys.objects(connectionId, request.database, request.schema, request.kind);
+    case 'table':
+      return metaKeys.table(connectionId, request.table, request.kind);
+  }
+}
+
+/**
+ * The queries a refreshed node makes stale (mirror of the backend's `CacheData::invalidate`):
+ * a node covers everything below it, and a level never drops the list that holds it.
+ */
+export function invalidationFilters(
+  connectionId: string,
+  node: MetaNode,
+): InvalidateQueryFilters[] {
+  switch (node.level) {
+    case 'connection':
+      return [{ queryKey: metaKeys.connection(connectionId) }];
+    case 'database':
+      return [{ queryKey: metaKeys.database(connectionId, node.database) }];
+    case 'schema':
+      return [{ queryKey: metaKeys.schema(connectionId, node.database, node.schema) }];
+    case 'objects': {
+      const schema = metaKeys.schema(connectionId, node.database, node.schema);
+      return [
+        { queryKey: [...schema, 'counts'] },
+        { queryKey: [...schema, 'objects', node.kind] },
+        { queryKey: [...schema, 'table', node.kind] },
+      ];
+    }
+    case 'table': {
+      const schema = metaKeys.schema(connectionId, node.table.database, node.table.schema);
+      // The node does not say whether it is a table or a view: match on the name.
+      return [
+        {
+          queryKey: [...schema, 'table'],
+          predicate: (query) => query.queryKey[8] === node.table.name,
+        },
+      ];
+    }
+  }
+}
diff --git a/src/features/explorer/metaSource.ts b/src/features/explorer/metaSource.ts
new file mode 100644
index 0000000..5dacec5
--- /dev/null
+++ b/src/features/explorer/metaSource.ts
@@ -0,0 +1,61 @@
+import type { QueryClient, QueryState } from '@tanstack/react-query';
+
+import { YadbeIpcError, type YadbeError } from '../../ipc';
+import { fetchMeta } from './metaApi';
+import { requestKey, type MetaRequest } from './metaKeys';
+import type { Loadable, MetaSource } from './explorerRows';
+
+/** The query behind one node: data stay cached until a refresh, the backend has its own cache. */
+export function metaQuery(connectionId: string, request: MetaRequest) {
+  return {
+    queryKey: requestKey(connectionId, request),
+    queryFn: ({ signal }: { signal: AbortSignal }) => fetchMeta(connectionId, request, signal),
+    staleTime: Infinity,
+    // A collapsed node keeps its data a while: opening it again is instant.
+    gcTime: 10 * 60_000,
+  };
+}
+
+const INTERNAL: YadbeError = {
+  code: 'internal',
+  message: { en: 'Unexpected error.', fr: 'Erreur inattendue.' },
+  action: null,
+  detail: null,
+};
+
+function asLoadable<T>(state: QueryState<T> | undefined, fetch: boolean): Loadable<T> {
+  if (state === undefined) return fetch ? { state: 'loading' } : { state: 'idle' };
+  if (state.data !== undefined) return { state: 'ready', data: state.data };
+  if (state.fetchStatus === 'fetching') return { state: 'loading' };
+  if (state.status === 'error') {
+    const error = state.error instanceof YadbeIpcError ? state.error.error : INTERNAL;
+    return { state: 'error', error };
+  }
+  return { state: 'loading' };
+}
+
+/**
+ * The tree's view of the query cache. Every request made with `fetch` is recorded, so that the
+ * caller can observe (and so load) exactly the nodes that are open on screen.
+ */
+export function createCacheSource(
+  client: QueryClient,
+  connectionId: string,
+  record: (connectionId: string, request: MetaRequest) => void,
+): MetaSource {
+  const read = <T>(request: MetaRequest, fetch: boolean): Loadable<T> => {
+    if (fetch) record(connectionId, request);
+    return asLoadable(
+      client.getQueryState<T>(requestKey(connectionId, request) as unknown[]),
+      fetch,
+    );
+  };
+  return {
+    databases: (fetch) => read({ type: 'databases' }, fetch),
+    schemas: (database, fetch) => read({ type: 'schemas', database }, fetch),
+    counts: (database, schema, fetch) => read({ type: 'counts', database, schema }, fetch),
+    objects: (database, schema, kind, fetch) =>
+      read({ type: 'objects', database, schema, kind }, fetch),
+    table: (table, kind, fetch) => read({ type: 'table', table, kind }, fetch),
+  };
+}
diff --git a/src/features/explorer/testSource.ts b/src/features/explorer/testSource.ts
new file mode 100644
index 0000000..bad000e
--- /dev/null
+++ b/src/features/explorer/testSource.ts
@@ -0,0 +1,92 @@
+import type { Capabilities, YadbeError } from '../../ipc';
+import { MOCK_OBJECT_KINDS, type MockDatabase } from '../../ipc/mock/metaCatalog';
+import type { Engine } from '../../ipc';
+import type { Loadable, MetaSource } from './explorerRows';
+import { requestKey, type MetaRequest } from './metaKeys';
+
+/** Tests only: a `MetaSource` over the mock catalog, with requests recorded and failures on demand. */
+export function catalogSource(
+  engine: Engine,
+  databases: MockDatabase[],
+  options: {
+    /** Requests (by `requestKey`) that never answer. */
+    loading?: (request: MetaRequest) => boolean;
+    error?: (request: MetaRequest) => YadbeError | undefined;
+  } = {},
+) {
+  const requested: MetaRequest[] = [];
+  const answer = <T>(request: MetaRequest, fetch: boolean, read: () => T): Loadable<T> => {
+    if (fetch) requested.push(request);
+    const error = options.error?.(request);
+    if (error) return { state: 'error', error };
+    if (options.loading?.(request)) return fetch ? { state: 'loading' } : { state: 'idle' };
+    return { state: 'ready', data: read() };
+  };
+  const schemaOf = (database: string, schema: string | null) =>
+    databases
+      .find((d) => d.info.name === database)
+      ?.schemas.find((s) => (s.info?.name ?? null) === schema);
+  const source: MetaSource = {
+    databases: (fetch) =>
+      answer({ type: 'databases' }, fetch, () => databases.map((database) => database.info)),
+    schemas: (database, fetch) =>
+      answer({ type: 'schemas', database }, fetch, () =>
+        (databases.find((d) => d.info.name === database)?.schemas ?? []).flatMap((s) =>
+          s.info ? [s.info] : [],
+        ),
+      ),
+    counts: (database, schema, fetch) =>
+      answer({ type: 'counts', database, schema }, fetch, () =>
+        (MOCK_OBJECT_KINDS[engine] ?? []).map((kind) => {
+          const objects = (schemaOf(database, schema)?.objects ?? []).filter(
+            (o) => o.kind === kind,
+          );
+          return {
+            kind,
+            count: objects.length,
+            systemCount: objects.filter((o) => o.system).length,
+          };
+        }),
+      ),
+    objects: (database, schema, kind, fetch) =>
+      answer({ type: 'objects', database, schema, kind }, fetch, () =>
+        (schemaOf(database, schema)?.objects ?? []).filter((o) => o.kind === kind),
+      ),
+    table: (table, kind, fetch) =>
+      answer({ type: 'table', table, kind }, fetch, () => {
+        const details = schemaOf(table.database, table.schema)?.tables.get(table.name);
+        if (!details) throw new Error(`no such table ${table.name}`);
+        return details;
+      }),
+  };
+  return {
+    source,
+    requested,
+    keys: () => requested.map((r) => JSON.stringify(requestKey('c', r))),
+  };
+}
+
+export const POSTGRES: Capabilities = {
+  usesFile: false,
+  defaultPort: 5432,
+  supportsTls: true,
+  multipleDatabases: true,
+  schemas: true,
+  nativeCancel: true,
+  readOnlySession: true,
+};
+
+export const SQLITE: Capabilities = {
+  usesFile: true,
+  defaultPort: null,
+  supportsTls: false,
+  multipleDatabases: false,
+  schemas: false,
+  nativeCancel: false,
+  readOnlySession: false,
+};
+
+export const MYSQL: Capabilities = {
+  ...POSTGRES,
+  schemas: false,
+};
