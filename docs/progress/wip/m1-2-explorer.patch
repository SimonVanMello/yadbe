index 0000000..0347ae4
--- /dev/null
+++ b/src/features/explorer/ExplorerRow.tsx
@@ -0,0 +1,380 @@
+import { memo, type CSSProperties, type ReactNode } from 'react';
+
+import { useT } from '../../i18n/useT';
+import { Button } from '../../ui/Button';
+import { Icon, type IconName } from '../../ui/Icon';
+import { Spinner } from '../../ui/Spinner';
+import { Tooltip } from '../../ui/Tooltip';
+import { Highlight } from '../connections/Highlight';
+import { rowStyle } from '../sidebar/rowStyle';
+import styles from './ExplorerRow.module.css';
+import { explorerRowLabel, GROUP_ICONS, groupLabel, kindLabel, KIND_ICONS } from './explorerLabels';
+import type { ExplorerRow as Row } from './explorerRows';
+import { ExplorerContextMenu } from './ExplorerContextMenu';
+
+export interface ExplorerRowProps {
+  row: Row;
+  id: string;
+  index: number;
+  active: boolean;
+  posInSet: number;
+  setSize: number;
+  /** Distance from the top of the list, and the height of the row, in px. */
+  offset: number;
+  height: number;
+  onSelect: (index: number) => void;
+  onToggle: (row: Row) => void;
+  onOpen: (row: Row) => void;
+  onRefresh: (row: Row) => void;
+}
+
+type Translate = ReturnType<typeof useT>;
+
+interface Content {
+  icon: IconName | null;
+  /** CSS class of the icon (color). */
+  iconTone?: string;
+  /** The name, highlighted while filtering. */
+  name: ReactNode;
+  /** What follows the name: a type, a count… */
+  meta?: ReactNode;
+  /** Small icons after the meta (identity, generated…). */
+  badges?: IconName[];
+  /** Details shown in a tooltip. */
+  tooltip?: ReactNode;
+}
+
+function Lines({ lines }: { lines: (string | null | undefined | false)[] }) {
+  return (
+    <span className={styles.tooltip}>
+      {lines.map((line, index) =>
+        line ? (
+          <span key={index} className={index === 0 ? styles.tooltipTitle : undefined}>
+            {line}
+          </span>
+        ) : null,
+      )}
+    </span>
+  );
+}
+
+function contentOf(row: Row, t: Translate): Content {
+  const name = (text: string) => <Highlight text={text} indices={row.indices} />;
+  switch (row.type) {
+    case 'database':
+      return {
+        icon: 'database',
+        name: name(row.database.name),
+        tooltip: row.database.accessible ? (
+          row.database.comment ? (
+            <Lines lines={[row.database.name, row.database.comment]} />
+          ) : undefined
+        ) : (
+          <Lines lines={[row.database.name, t('explorer.noAccess')]} />
+        ),
+      };
+    case 'schema':
+      return {
+        icon: 'layers',
+        name: name(row.schema.name),
+        tooltip: row.schema.comment ? (
+          <Lines lines={[row.schema.name, row.schema.comment]} />
+        ) : undefined,
+      };
+    case 'kind':
+      return {
+        icon: KIND_ICONS[row.kind],
+        name: kindLabel(t, row.kind),
+        meta: <span className={styles.count}>{row.count}</span>,
+      };
+    case 'object': {
+      const { object } = row;
+      const detail = object.detail;
+      let meta: ReactNode;
+      if (detail.type === 'routine') {
+        meta = `(${detail.arguments})`;
+      } else if (detail.type === 'sequence') {
+        meta = detail.dataType;
+      } else if (detail.type === 'type') {
+        meta = detail.category;
+      }
+      return {
+        icon: KIND_ICONS[object.kind],
+        name: name(object.name),
+        meta,
+        tooltip: object.comment ? <Lines lines={[object.name, object.comment]} /> : undefined,
+      };
+    }
+    case 'detailGroup':
+      return {
+        icon: GROUP_ICONS[row.group],
+        name: groupLabel(t, row.group),
+        meta: <span className={styles.count}>{row.count}</span>,
+      };
+    case 'column': {
+      const { column } = row;
+      const badges: IconName[] = [];
+      if (column.primaryKey && column.foreignKey) badges.push('link');
+      if (column.identity !== null) badges.push('hash');
+      if (column.generated !== null) badges.push('formula');
+      const icon: IconName = column.primaryKey ? 'key' : column.foreignKey ? 'link' : 'columns';
+      return {
+        icon,
+        iconTone: column.primaryKey
+          ? styles.keyTone
+          : column.foreignKey
+            ? styles.linkTone
+            : styles.mutedTone,
+        name: name(column.name),
+        meta: (
+          <>
+            {column.typeName}
+            <span className={styles.nullability}>
+              {column.nullable ? ' · NULL' : ' · NOT NULL'}
+            </span>
+          </>
+        ),
+        badges,
+        tooltip: (
+          <Lines
+            lines={[
+              `${column.name}: ${column.typeName}`,
+              column.nullable ? t('explorer.col.nullable') : t('explorer.col.notNull'),
+              column.default !== null && `${t('explorer.col.default')}: ${column.default}`,
+              column.primaryKey && t('explorer.col.primaryKey'),
+              column.foreignKey && t('explorer.col.foreignKey'),
+              column.identity !== null && t(`explorer.col.identity.${column.identity}`),
+              column.generated !== null &&
+                `${t(column.generated.stored ? 'explorer.col.generated.stored' : 'explorer.col.generated.virtual')}${column.generated.expression ? `: ${column.generated.expression}` : ''}`,
+              column.comment,
+            ]}
+          />
+        ),
+      };
+    }
+    case 'key':
+      return {
+        icon: 'key',
+        iconTone: row.primary ? styles.keyTone : undefined,
+        name: name(row.name ?? row.columns.join(', ')),
+        meta: `${row.primary ? t('explorer.key.primary') : t('explorer.key.unique')} (${row.columns.join(', ')})`,
+      };
+    case 'foreignKey': {
+      const { foreignKey } = row;
+      const target = foreignKey.referencedTable;
+      const targetName = target.schema === null ? target.name : `${target.schema}.${target.name}`;
+      return {
+        icon: 'link',
+        iconTone: styles.linkTone,
+        name: name(foreignKey.name ?? foreignKey.columns.join(', ')),
+        meta: `→ ${targetName} (${foreignKey.referencedColumns.join(', ')})`,
+        tooltip: (
+          <Lines
+            lines={[
+              `${foreignKey.columns.join(', ')} → ${targetName} (${foreignKey.referencedColumns.join(', ')})`,
+              t('explorer.fk.onDelete', { action: foreignKey.onDelete }),
+              t('explorer.fk.onUpdate', { action: foreignKey.onUpdate }),
+            ]}
+          />
+        ),
+      };
+    }
+    case 'index': {
+      const { index } = row;
+      const flags = [
+        index.primary
+          ? t('explorer.index.primary')
+          : index.unique
+            ? t('explorer.index.unique')
+            : '',
+        index.method ?? '',
+      ].filter(Boolean);
+      return {
+        icon: 'index',
+        name: name(index.name),
+        meta: `${flags.length > 0 ? `${flags.join(', ')} ` : ''}(${index.columns.join(', ')})`,
+        tooltip: index.definition ? <Lines lines={[index.name, index.definition]} /> : undefined,
+      };
+    }
+    case 'check':
+      return {
+        icon: 'checkSquare',
+        name: name(row.check.name ?? row.check.expression),
+        meta: row.check.name ? row.check.expression : undefined,
+        tooltip: <Lines lines={[row.check.name, row.check.expression]} />,
+      };
+    case 'trigger': {
+      const { trigger } = row;
+      const timing = trigger.timing === 'insteadOf' ? 'INSTEAD OF' : trigger.timing.toUpperCase();
+      return {
+        icon: 'bolt',
+        name: name(trigger.name),
+        meta: `${timing} ${trigger.events.map((event) => event.toUpperCase()).join(' OR ')}${trigger.enabled ? '' : ` · ${t('explorer.trigger.disabled')}`}`,
+        tooltip: (
+          <Lines
+            lines={[
+              trigger.name,
+              trigger.function,
+              trigger.forEachRow
+                ? t('explorer.trigger.rowLevel')
+                : t('explorer.trigger.statementLevel'),
+              trigger.definition,
+            ]}
+          />
+        ),
+      };
+    }
+    case 'status':
+      return { icon: null, name: explorerRowLabel(row, t) };
+  }
+}
+
+/** One row of an open connection's tree: database, schema, kind, object, column… (F-020, F-021). */
+export const ExplorerRow = memo(function ExplorerRow({
+  row,
+  id,
+  index,
+  active,
+  posInSet,
+  setSize,
+  offset,
+  height,
+  onSelect,
+  onToggle,
+  onOpen,
+  onRefresh,
+}: ExplorerRowProps) {
+  const t = useT();
+  const depth = row.level - 1;
+  const common = {
+    id,
+    role: 'treeitem',
+    'aria-level': row.level,
+    'aria-posinset': posInSet,
+    'aria-setsize': setSize,
+    'data-row-index': index,
+    'data-active': active || undefined,
+    style: { ...rowStyle(offset, height), '--depth': depth } as CSSProperties,
+  };
+
+  if (row.type === 'status') {
+    const failed = row.status === 'error';
+    const message = explorerRowLabel(row, t);
+    return (
+      <div
+        {...common}
+        aria-selected={active}
+        aria-label={message}
+        data-status={row.status}
+        className={styles.row}
+        onClick={() => {
+          onSelect(index);
+        }}
+      >
+        <span className={styles.twisty} />
+        {row.status === 'loading' && <Spinner />}
+        {failed && <Icon name="warning" className={styles.errorTone} />}
+        <span className={styles.statusText} title={message}>
+          {message}
+        </span>
+        {failed && (
+          <Button
+            size="sm"
+            variant="secondary"
+            tabIndex={-1}
+            onClick={(event) => {
+              event.stopPropagation();
+              onRefresh(row);
+            }}
+          >
+            {t('explorer.retry')}
+          </Button>
+        )}
+      </div>
+    );
+  }
+
+  const content = contentOf(row, t);
+  const disabled = row.type === 'database' && !row.database.accessible;
+  const refreshable =
+    row.type === 'database' ||
+    row.type === 'schema' ||
+    row.type === 'kind' ||
+    (row.type === 'object' && row.expandable);
+  const label = explorerRowLabel(row, t);
+  const ariaLabel = row.type === 'column' ? `${label}, ${row.column.typeName}` : label;
+
+  const body = (
+    <div
+      {...common}
+      aria-selected={active}
+      aria-expanded={row.expandable ? row.expanded : undefined}
+      aria-disabled={disabled || undefined}
+      aria-label={ariaLabel}
+      data-type={row.type}
+      className={styles.row}
+      onClick={() => {
+        onSelect(index);
+        // Containers open with a click; objects and connections only select (double click opens).
+        if (row.expandable && row.type !== 'object') onToggle(row);
+      }}
+      onDoubleClick={() => {
+        onOpen(row);
+      }}
+    >
+      <span
+        className={styles.twisty}
+        onClick={(event) => {
+          if (!row.expandable) return;
+          event.stopPropagation();
+          onSelect(index);
+          onToggle(row);
+        }}
+      >
+        {row.expandable && <Icon name={row.expanded ? 'chevronDown' : 'chevronRight'} />}
+      </span>
+      {content.icon && (
+        <Icon
+          name={content.icon}
+          className={[styles.icon, content.iconTone].filter(Boolean).join(' ')}
+        />
+      )}
+      {(() => {
+        const text = (
+          <span className={styles.text}>
+            <span className={styles.name}>{content.name}</span>
+            {content.meta !== undefined && <span className={styles.meta}>{content.meta}</span>}
+          </span>
+        );
+        return content.tooltip ? (
+          <Tooltip side="right" content={content.tooltip}>
+            {text}
+          </Tooltip>
+        ) : (
+          text
+        );
+      })()}
+      {content.badges?.map((badge, position) => (
+        <Icon key={position} name={badge} className={styles.badge} />
+      ))}
+      {refreshable && (
+        <button
+          type="button"
+          tabIndex={-1}
+          className={styles.refresh}
+          aria-label={t('explorer.refresh', { name: label })}
+          onClick={(event) => {
+            event.stopPropagation();
+            onRefresh(row);
+          }}
+          onDoubleClick={(event) => {
+            event.stopPropagation();
+          }}
+        >
+          <Icon name="retry" />
+        </button>
+      )}
+    </div>
+  );
+  return <ExplorerContextMenu row={row}>{body}</ExplorerContextMenu>;
+});
diff --git a/src/features/explorer/explorerActions.ts b/src/features/explorer/explorerActions.ts
new file mode 100644
index 0000000..2062c55
--- /dev/null
+++ b/src/features/explorer/explorerActions.ts
@@ -0,0 +1,123 @@
+import { showError } from '../../app/errors/presentError';
+import { openQueryTabWith } from '../../app/tabs/tabsStore';
+import { translate, useI18nStore, type MessageKey, type MessageParams } from '../../i18n/i18n';
+import { ipc, unwrap, type MetaNode, type ObjectRef, type ScriptKind } from '../../ipc';
+import { toast } from '../../ui/toastStore';
+import { isRelationKind, type ExplorerRow } from './explorerRows';
+
+function t(key: MessageKey, params?: MessageParams): string {
+  return translate(useI18nStore.getState().locale, key, params);
+}
+
+/** "New query" on a connection, a database or any object of it. */
+export function newQuery(connectionId: string, database: string | null): void {
+  openQueryTabWith({ connectionId, database });
+}
+
+/** Opens a new query tab holding the script of a table (F-023). */
+export async function scriptAs(
+  connectionId: string,
+  table: ObjectRef,
+  script: Exclude<ScriptKind, 'qualifiedName'>,
+): Promise<void> {
+  try {
+    const text = await unwrap(ipc.commands.scriptTable(connectionId, table, script));
+    openQueryTabWith({ connectionId, database: table.database, initialText: text });
+  } catch (error) {
+    showError(error, { title: t('explorer.scriptFailed', { name: table.name }) });
+  }
+}
+
+/**
+ * What a double click (or Enter) on a table does. Table tabs arrive with table editing (M2):
+ * until then it is the same as "Script as SELECT" in a new query tab.
+ */
+export function openTable(connectionId: string, table: ObjectRef): Promise<void> {
+  return scriptAs(connectionId, table, 'select');
+}
+
+async function copyText(text: string, what: string): Promise<void> {
+  try {
+    await navigator.clipboard.writeText(text);
+    toast({ variant: 'success', title: t('explorer.copied', { what }) });
+  } catch (error) {
+    showError(error, { title: t('explorer.copyFailed') });
+  }
+}
+
+export function copyName(name: string): Promise<void> {
+  return copyText(name, t('explorer.what.name'));
+}
+
+/** The name as the engine writes it, quoted and qualified by its dialect. */
+export async function copyQualifiedName(connectionId: string, table: ObjectRef): Promise<void> {
+  try {
+    const name = await unwrap(ipc.commands.scriptTable(connectionId, table, 'qualifiedName'));
+    await copyText(name, t('explorer.what.qualifiedName'));
+  } catch (error) {
+    showError(error, { title: t('explorer.copyFailed') });
+  }
+}
+
+/** Drops the cached metadata of a node: the backend answers with `meta-refreshed`. */
+export async function refreshNode(connectionId: string, node: MetaNode): Promise<void> {
+  try {
+    await unwrap(ipc.commands.refreshMeta(connectionId, node));
+  } catch (error) {
+    showError(error, { title: t('explorer.refreshFailed') });
+  }
+}
+
+/** The node an explorer row stands for, in the backend's terms (`null`: nothing to refresh). */
+export function metaNodeOf(row: ExplorerRow): MetaNode | null {
+  switch (row.type) {
+    case 'database':
+      return { level: 'database', database: row.database.name };
+    case 'schema':
+      return { level: 'schema', database: row.database, schema: row.schema.name };
+    case 'kind':
+      return { level: 'objects', database: row.database, schema: row.schema, kind: row.kind };
+    case 'object':
+      return isRelationKind(row.object.kind)
+        ? { level: 'table', table: row.ref }
+        : {
+            level: 'objects',
+            database: row.ref.database,
+            schema: row.ref.schema,
+            kind: row.object.kind,
+          };
+    case 'detailGroup':
+    case 'column':
+    case 'key':
+    case 'foreignKey':
+    case 'index':
+    case 'check':
+    case 'trigger':
+      return { level: 'table', table: row.table };
+    case 'status':
+      return row.refresh;
+  }
+}
+
+/** The database a row lives in, for "New query"; `null` on the connection's own row. */
+export function databaseOf(row: ExplorerRow): string | null {
+  switch (row.type) {
+    case 'database':
+      return row.database.name;
+    case 'schema':
+    case 'kind':
+      return row.database;
+    case 'object':
+      return row.ref.database;
+    case 'detailGroup':
+    case 'column':
+    case 'key':
+    case 'foreignKey':
+    case 'index':
+    case 'check':
+    case 'trigger':
+      return row.table.database;
+    case 'status':
+      return null;
+  }
+}
diff --git a/src/features/explorer/explorerLabels.ts b/src/features/explorer/explorerLabels.ts
new file mode 100644
index 0000000..9668082
--- /dev/null
+++ b/src/features/explorer/explorerLabels.ts
@@ -0,0 +1,101 @@
+import type { MessageKey, MessageParams } from '../../i18n/i18n';
+import type { ObjectKind } from '../../ipc';
+import type { IconName } from '../../ui/Icon';
+import { localize } from '../../app/errors/presentError';
+import type { DetailGroup, ExplorerRow, StatusSubject } from './explorerRows';
+
+type Translate = (key: MessageKey, params?: MessageParams) => string;
+
+const KIND_LABELS: Record<ObjectKind, MessageKey> = {
+  table: 'explorer.kind.table',
+  view: 'explorer.kind.view',
+  materializedView: 'explorer.kind.materializedView',
+  function: 'explorer.kind.function',
+  procedure: 'explorer.kind.procedure',
+  sequence: 'explorer.kind.sequence',
+  type: 'explorer.kind.type',
+};
+
+const GROUP_LABELS: Record<DetailGroup, MessageKey> = {
+  columns: 'explorer.group.columns',
+  keys: 'explorer.group.keys',
+  foreignKeys: 'explorer.group.foreignKeys',
+  indexes: 'explorer.group.indexes',
+  constraints: 'explorer.group.constraints',
+  triggers: 'explorer.group.triggers',
+};
+
+const EMPTY_LABELS: Record<StatusSubject, MessageKey> = {
+  connecting: 'explorer.status.loading',
+  databases: 'explorer.status.empty.databases',
+  schemas: 'explorer.status.empty.schemas',
+  kinds: 'explorer.status.empty.kinds',
+  objects: 'explorer.status.empty.objects',
+  details: 'explorer.status.empty.details',
+};
+
+export const KIND_ICONS: Record<ObjectKind, IconName> = {
+  table: 'table',
+  view: 'view',
+  materializedView: 'matView',
+  function: 'routine',
+  procedure: 'routine',
+  sequence: 'sequence',
+  type: 'tag',
+};
+
+export const GROUP_ICONS: Record<DetailGroup, IconName> = {
+  columns: 'columns',
+  keys: 'key',
+  foreignKeys: 'link',
+  indexes: 'index',
+  constraints: 'checkSquare',
+  triggers: 'bolt',
+};
+
+export const kindLabel = (t: Translate, kind: ObjectKind) => t(KIND_LABELS[kind]);
+export const groupLabel = (t: Translate, group: DetailGroup) => t(GROUP_LABELS[group]);
+
+/** Name of a foreign key, or the columns it covers when it has none. */
+function foreignKeyName(row: Extract<ExplorerRow, { type: 'foreignKey' }>): string {
+  const { foreignKey } = row;
+  return foreignKey.name ?? foreignKey.columns.join(', ');
+}
+
+/** Text of a row without its decorations: for the type-ahead and the accessible name. */
+export function explorerRowLabel(row: ExplorerRow, t: Translate): string {
+  switch (row.type) {
+    case 'database':
+      return row.database.name;
+    case 'schema':
+      return row.schema.name;
+    case 'kind':
+      return `${kindLabel(t, row.kind)} (${String(row.count)})`;
+    case 'object':
+      return row.object.name;
+    case 'detailGroup':
+      return `${groupLabel(t, row.group)} (${String(row.count)})`;
+    case 'column':
+      return row.column.name;
+    case 'key':
+      return row.name ?? row.columns.join(', ');
+    case 'foreignKey':
+      return foreignKeyName(row);
+    case 'index':
+      return row.index.name;
+    case 'check':
+      return row.check.name ?? row.check.expression;
+    case 'trigger':
+      return row.trigger.name;
+    case 'status':
+      if (row.status === 'error') {
+        return row.error ? localize(row.error.message) : t('explorer.status.failed');
+      }
+      if (row.status === 'loading') {
+        return t(
+          row.subject === 'connecting' ? 'explorer.status.connecting' : 'explorer.status.loading',
+        );
+      }
+      return t(EMPTY_LABELS[row.subject]);
+  }
+}
diff --git a/src/features/explorer/explorerRows.test.ts b/src/features/explorer/explorerRows.test.ts
new file mode 100644
index 0000000..ffbc73d
--- /dev/null
+++ b/src/features/explorer/explorerRows.test.ts
@@ -0,0 +1,347 @@
+import { describe, expect, it } from 'vitest';
+
+import { postgresServer, sqliteFile } from '../../ipc/mock/metaCatalog';
+import {
+  buildNodes,
+  flattenNodes,
+  nodeKeys,
+  pruneNodes,
+  type ExplorerLevels,
+  type ExplorerRow,
+  type MetaSource,
+} from './explorerRows';
+import { catalogSource } from './testSource';
+
+const ORDERS = { database: 'app_dev', schema: 'shop', name: 'orders' } as const;
+
+const PG_LEVELS: ExplorerLevels = { databases: true, schemas: true };
+const SQLITE_LEVELS: ExplorerLevels = { databases: false, schemas: false };
+
+interface Setup {
+  levels?: ExplorerLevels;
+  source: MetaSource;
+  expanded?: string[];
+  showSystem?: boolean;
+  exhaustive?: boolean;
+  fetching?: boolean;
+}
+
+function rows({
+  levels = PG_LEVELS,
+  source,
+  expanded = [],
+  showSystem = false,
+  exhaustive = false,
+  fetching = true,
+}: Setup): ExplorerRow[] {
+  const open = new Set(expanded);
+  const nodes = buildNodes({ levels, showSystem, expanded: open, source, exhaustive }, fetching);
+  return flattenNodes(nodes, { connectionId: 'c', level: 2, expanded: open, open: false });
+}
+
+/** `type:name` of each row, indented by level, to read a tree at a glance. */
+function outline(list: ExplorerRow[]): string[] {
+  return list.map((row) => {
+    let text: string = row.type;
+    if (row.type === 'database') text += `:${row.database.name}`;
+    if (row.type === 'schema') text += `:${row.schema.name}`;
+    if (row.type === 'kind') text += `:${row.kind}(${String(row.count)})`;
+    if (row.type === 'object') text += `:${row.object.name}`;
+    if (row.type === 'detailGroup') text += `:${row.group}(${String(row.count)})`;
+    if (row.type === 'column') text += `:${row.column.name}`;
+    if (row.type === 'status') text += `:${row.status}`;
+    return `${'  '.repeat(row.level - 2)}${text}`;
+  });
+}
+
+const pg = (options?: Parameters<typeof catalogSource>[2]) =>
+  catalogSource('postgres', postgresServer('app_dev', null), options);
+const sqlite = (options?: Parameters<typeof catalogSource>[2]) =>
+  catalogSource('sqlite', sqliteFile(), options);
+
+describe('levels follow the capabilities', () => {
+  it('lists the databases of a server, system ones hidden, inaccessible ones disabled', () => {
+    const { source } = pg();
+    const list = rows({ source });
+    expect(outline(list)).toEqual([
+      'database:analytics_archive',
+      'database:app_dev',
+      'database:postgres',
+    ]);
+    const archive = list[0];
+    expect(archive?.type === 'database' && archive.database.accessible).toBe(false);
+    expect(archive?.expandable).toBe(false);
+    expect(list[1]?.expandable).toBe(true);
+  });
+
+  it('goes database → schema → kinds → objects → table details', () => {
+    const { source } = pg();
+    const list = rows({
+      source,
+      expanded: [
+        nodeKeys.database('app_dev'),
+        nodeKeys.schema('app_dev', 'shop'),
+        nodeKeys.kind('app_dev', 'shop', 'table'),
+        nodeKeys.object('app_dev', 'shop', 'table', 'orders'),
+        nodeKeys.group(ORDERS, 'table', 'columns'),
+      ],
+    });
+    const text = outline(list);
+    expect(text).toContain('  schema:shop');
+    expect(text).toContain('    kind:table(21)');
+    expect(text).toContain('      object:orders');
+    expect(text).toContain('        detailGroup:columns(10)');
+    expect(text).toContain('          column:id');
+    // Groups with nothing in them are left out, the columns always stay.
+    const groups = list.flatMap((row) => (row.type === 'detailGroup' ? [row.group] : []));
+    expect(groups).toEqual(['columns', 'keys', 'foreignKeys', 'indexes', 'triggers']);
+    const columns = list.find((row) => row.type === 'detailGroup');
+    expect(columns).toMatchObject({ expandable: true, expanded: true, level: 6 });
+  });
+
+  it('has no database and no schema level on SQLite: the kinds hang off the connection', () => {
+    const { source, requested } = sqlite();
+    const list = rows({ levels: SQLITE_LEVELS, source });
+    expect(outline(list)[0]).toBe('kind:table(4)');
+    expect(list.every((row) => row.level === 2)).toBe(true);
+    // `main` is read from the database list, and the objects are asked with `schema: null`.
+    expect(requested).toEqual([
+      { type: 'databases' },
+      { type: 'counts', database: 'main', schema: null },
+    ]);
+  });
+
+  it('skips the schema level on an engine with several databases but no schemas', () => {
+    const { source } = pg();
+    const list = rows({
+      levels: { databases: true, schemas: false },
+      source,
+      expanded: [nodeKeys.database('app_dev')],
+    });
+    const text = outline(list);
+    expect(text.slice(0, 3)).toEqual([
+      'database:analytics_archive',
+      'database:app_dev',
+      '  kind:table(0)',
+    ]);
+  });
+
+  it('opens objects of a kind other than relations without details', () => {
+    const { source } = pg();
+    const kinds = [
+      nodeKeys.database('app_dev'),
+      nodeKeys.schema('app_dev', 'shop'),
+      nodeKeys.kind('app_dev', 'shop', 'function'),
+    ];
+    const list = rows({ source, expanded: kinds });
+    const fn = list.find((row) => row.type === 'object');
+    expect(fn).toMatchObject({ expandable: false, expanded: false });
+  });
+});
+
+describe('system objects', () => {
+  it('hides system schemas and subtracts system objects from the counts', () => {
+    const { source } = sqlite();
+    const hidden = rows({ levels: SQLITE_LEVELS, source });
+    expect(hidden[0]).toMatchObject({ type: 'kind', kind: 'table', count: 4 });
+    const shown = rows({ levels: SQLITE_LEVELS, source, showSystem: true });
+    expect(shown[0]).toMatchObject({ type: 'kind', kind: 'table', count: 5 });
+  });
+
+  it('lists system databases and schemas on demand', () => {
+    const { source } = pg();
+    const open = [nodeKeys.database('app_dev')];
+    expect(outline(rows({ source, expanded: open }))).not.toContain('  schema:pg_catalog');
+    const all = outline(rows({ source, expanded: open, showSystem: true }));
+    expect(all).toContain('  schema:pg_catalog');
+    expect(all).toContain('database:template1');
+  });
+
+  it('hides the objects themselves too', () => {
+    const { source } = sqlite();
+    const kind = [nodeKeys.kind('main', null, 'table')];
+    const hidden = outline(rows({ levels: SQLITE_LEVELS, source, expanded: kind }));
+    expect(hidden.filter((line) => line.includes('sqlite_sequence'))).toEqual([]);
+    const shown = outline(
+      rows({ levels: SQLITE_LEVELS, source, expanded: kind, showSystem: true }),
+    );
+    expect(shown.filter((line) => line.includes('sqlite_sequence'))).toHaveLength(1);
+  });
+});
+
+describe('lazy loading', () => {
+  it('asks for nothing under a collapsed node', () => {
+    const { source, requested } = pg();
+    rows({ source });
+    expect(requested).toEqual([{ type: 'databases' }]);
+  });
+
+  it('asks only for the open nodes', () => {
+    const { source, requested } = pg();
+    rows({
+      source,
+      expanded: [
+        nodeKeys.database('app_dev'),
+        nodeKeys.schema('app_dev', 'shop'),
+        nodeKeys.kind('app_dev', 'shop', 'view'),
+        // Open, but under a node that is closed: not asked for.
+        nodeKeys.kind('app_dev', 'sales', 'table'),
+      ],
+    });
+    expect(requested).toEqual([
+      { type: 'databases' },
+      { type: 'schemas', database: 'app_dev' },
+      { type: 'counts', database: 'app_dev', schema: 'shop' },
+      { type: 'objects', database: 'app_dev', schema: 'shop', kind: 'view' },
+    ]);
+  });
+
+  it('does not ask for anything while the connection is not up', () => {
+    const { source, requested } = pg();
+    const list = rows({ source, expanded: [nodeKeys.database('app_dev')], fetching: false });
+    expect(requested).toEqual([]);
+    expect(outline(list)).toContain('  schema:shop');
+  });
+
+  it('shows a loading row under a node that is on its way', () => {
+    const { source } = pg({ loading: (r) => r.type === 'schemas' });
+    const list = rows({ source, expanded: [nodeKeys.database('app_dev')] });
+    expect(outline(list)).toEqual([
+      'database:analytics_archive',
+      'database:app_dev',
+      '  status:loading',
+      'database:postgres',
+    ]);
+  });
+
+  it('shows the typed error on the node, with the node a retry refreshes', () => {
+    const notFound = {
+      code: 'objectNotFound' as const,
+      message: { en: 'gone', fr: 'disparu' },
+      action: null,
+      detail: null,
+    };
+    const { source } = pg({ error: (r) => (r.type === 'table' ? notFound : undefined) });
+    const list = rows({
+      source,
+      expanded: [
+        nodeKeys.database('app_dev'),
+        nodeKeys.schema('app_dev', 'shop'),
+        nodeKeys.kind('app_dev', 'shop', 'table'),
+        nodeKeys.object('app_dev', 'shop', 'table', 'orders'),
+      ],
+    });
+    const failed = list.find((row) => row.type === 'status');
+    expect(failed).toMatchObject({
+      status: 'error',
+      error: { code: 'objectNotFound' },
+      // The table is gone: the list it was in must be read again, not the table alone.
+      refresh: { level: 'objects', database: 'app_dev', schema: 'shop', kind: 'table' },
+    });
+    const queryFailed = { ...notFound, code: 'queryFailed' as const };
+    const other = pg({ error: (r) => (r.type === 'counts' ? queryFailed : undefined) });
+    const second = rows({
+      source: other.source,
+      expanded: [nodeKeys.database('app_dev'), nodeKeys.schema('app_dev', 'shop')],
+    });
+    expect(second.find((row) => row.type === 'status')).toMatchObject({
+      status: 'error',
+      refresh: { level: 'schema', database: 'app_dev', schema: 'shop' },
+    });
+  });
+
+  it('says so when a node has no children', () => {
+    const { source } = pg();
+    const list = rows({
+      source,
+      expanded: [nodeKeys.database('postgres'), nodeKeys.schema('postgres', 'public')],
+    });
+    // `postgres` only holds an empty `public` schema: its kinds all count 0 and cannot open.
+    expect(list.find((row) => row.type === 'kind')).toMatchObject({ count: 0, expandable: false });
+  });
+});
+
+describe('flat rows', () => {
+  it('gives every row a unique key and the right expanded state', () => {
+    const { source } = pg();
+    const list = rows({
+      source,
+      expanded: [nodeKeys.database('app_dev'), nodeKeys.schema('app_dev', 'shop')],
+    });
+    expect(new Set(list.map((row) => row.key)).size).toBe(list.length);
+    const shop = list.find((row) => row.type === 'schema' && row.schema.name === 'shop');
+    const auth = list.find((row) => row.type === 'schema' && row.schema.name === 'auth');
+    expect(shop?.expanded).toBe(true);
+    expect(auth?.expanded).toBe(false);
+  });
+});
+
+describe('filter', () => {
+  const open = [
+    nodeKeys.database('app_dev'),
+    nodeKeys.schema('app_dev', 'shop'),
+    nodeKeys.kind('app_dev', 'shop', 'table'),
+    nodeKeys.object('app_dev', 'shop', 'table', 'orders'),
+    nodeKeys.group(ORDERS, 'table', 'columns'),
+  ];
+
+  function filtered(query: string, expanded: string[] = open): ExplorerRow[] {
+    const { source } = pg();
+    const set = new Set(expanded);
+    const nodes = buildNodes(
+      { levels: PG_LEVELS, showSystem: false, expanded: set, source, exhaustive: true },
+      false,
+    );
+    return flattenNodes(pruneNodes(nodes, query), {
+      connectionId: 'c',
+      level: 2,
+      expanded: set,
+      open: true,
+    });
+  }
+
+  it('keeps the matches with their ancestors, and drops the rest', () => {
+    const text = outline(filtered('orders'));
+    expect(text).toContain('database:app_dev');
+    expect(text).toContain('  schema:shop');
+    expect(text).toContain('    kind:table(21)');
+    expect(text).toContain('      object:orders');
+    expect(text).not.toContain('      object:products');
+    expect(text).not.toContain('database:postgres');
+  });
+
+  it('looks inside the loaded nodes even where they are collapsed', () => {
+    // Nothing is expanded, but what was loaded stays in the cache: `fake` has it all.
+    const text = outline(filtered('customer_id', []));
+    expect(text).toContain('          column:customer_id');
+  });
+
+  it('highlights the matched characters', () => {
+    const found = filtered('ord').find(
+      (row) => row.type === 'object' && row.object.name === 'orders',
+    );
+    expect(found?.indices).toEqual([0, 1, 2]);
+  });
+
+  it('shows nothing for a query that matches nothing loaded', () => {
+    expect(filtered('zzzz')).toEqual([]);
+  });
+
+  it('leaves out the loading and failed rows', () => {
+    const { source } = pg({ loading: (r) => r.type === 'schemas' });
+    const set = new Set([nodeKeys.database('app_dev')]);
+    const nodes = buildNodes(
+      { levels: PG_LEVELS, showSystem: false, expanded: set, source, exhaustive: true },
+      true,
+    );
+    expect(pruneNodes(nodes, 'app')).toHaveLength(1);
+    expect(
+      flattenNodes(pruneNodes(nodes, 'app'), {
+        connectionId: 'c',
+        level: 2,
+        expanded: set,
+        open: true,
+      }),
+    ).toHaveLength(1);
+  });
+});
diff --git a/src/features/explorer/explorerRows.ts b/src/features/explorer/explorerRows.ts
