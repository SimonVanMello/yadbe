index 0000000..1c99c98
--- /dev/null
+++ b/src/features/sidebar/sidebarRows.test.ts
@@ -0,0 +1,204 @@
+import { describe, expect, it } from 'vitest';
+
+import { postgresServer, sqliteFile } from '../../ipc/mock/metaCatalog';
+import { MOCK_CONNECTIONS, MOCK_GROUPS } from '../../ipc/mockData';
+import { summarize, type ConnectionState } from '../connections/model';
+import { nodeKeys } from '../explorer/explorerRows';
+import { ROOT_NODE } from '../explorer/explorerStore';
+import { catalogSource, POSTGRES, SQLITE } from '../explorer/testSource';
+import {
+  composeSidebarRows,
+  treeShape,
+  type SidebarInput,
+  type SidebarTreeRow,
+} from './sidebarRows';
+
+const PG = 'conn-local-pg';
+const LITE = 'conn-app-sqlite';
+const connections = MOCK_CONNECTIONS.map(summarize);
+
+const pg = catalogSource('postgres', postgresServer('app_dev', null));
+const lite = catalogSource('sqlite', sqliteFile());
+
+function compose(
+  overrides: Partial<SidebarInput> & { states?: Record<string, ConnectionState> } = {},
+): SidebarTreeRow[] {
+  const { states = {}, ...rest } = overrides;
+  return composeSidebarRows({
+    connections,
+    groups: MOCK_GROUPS,
+    query: '',
+    capabilities: new Map([
+      ['postgres', POSTGRES],
+      ['sqlite', SQLITE],
+    ]),
+    stateOf: (id) => states[id] ?? 'disconnected',
+    expanded: {},
+    showSystem: false,
+    sourceFor: (id) => (id === LITE ? lite.source : pg.source),
+    ...rest,
+  });
+}
+
+const describeRow = (row: SidebarTreeRow): string => {
+  switch (row.type) {
+    case 'group':
+      return `group:${row.group.name}`;
+    case 'connection':
+      return `connection:${row.connection.name}`;
+    case 'database':
+      return `database:${row.database.name}`;
+    case 'schema':
+      return `schema:${row.schema.name}`;
+    case 'kind':
+      return `kind:${row.kind}`;
+    case 'object':
+      return `object:${row.object.name}`;
+    default:
+      return row.type;
+  }
+};
+
+describe('the sidebar rows', () => {
+  it('lists folders and connections, closed, when nothing is open', () => {
+    const rows = compose();
+    expect(rows.map(describeRow)).toEqual([
+      'group:Clients',
+      'group:ACME',
+      'connection:shop · prod',
+      'connection:shop · staging',
+      'connection:reporting',
+      'group:Local',
+      'connection:local postgres',
+      'connection:wordpress',
+      'connection:app.sqlite',
+      'connection:auth failure demo',
+    ]);
+    expect(rows.every((row) => row.type !== 'connection' || !row.expanded)).toBe(true);
+  });
+
+  it('puts the explorer of an open connection right under its row, one level deeper', () => {
+    const rows = compose({
+      states: { [PG]: 'connected' },
+      expanded: { [PG]: new Set([ROOT_NODE, nodeKeys.database('app_dev')]) },
+    });
+    const at = rows.findIndex((row) => row.type === 'connection' && row.connection.id === PG);
+    const connection = rows[at];
+    expect(connection).toMatchObject({ expanded: true, level: 2 });
+    const text = rows.slice(at + 1, at + 4).map(describeRow);
+    expect(text).toEqual(['database:analytics_archive', 'database:app_dev', 'schema:analytics']);
+    expect(rows[at + 1]?.level).toBe(3);
+    expect(rows[at + 3]?.level).toBe(4);
+  });
+
+  it('shows the kinds directly under a SQLite connection', () => {
+    const rows = compose({
+      states: { [LITE]: 'connected' },
+      expanded: { [LITE]: new Set([ROOT_NODE]) },
+    });
+    const at = rows.findIndex((row) => row.type === 'connection' && row.connection.id === LITE);
+    expect(rows.slice(at + 1, at + 3).map(describeRow)).toEqual(['kind:table', 'kind:view']);
+    expect(rows[at + 1]?.level).toBe(2);
+  });
+
+  it('shows what is being done while connecting, and nothing once closed', () => {
+    const connecting = compose({
+      states: { [PG]: 'connecting' },
+      expanded: { [PG]: new Set([ROOT_NODE]) },
+    });
+    const at = connecting.findIndex((row) => row.type === 'connection' && row.connection.id === PG);
+    expect(connecting[at + 1]).toMatchObject({ type: 'status', subject: 'connecting' });
+
+    const closed = compose({ expanded: { [PG]: new Set([ROOT_NODE]) } });
+    const row = closed.find((r) => r.type === 'connection' && r.connection.id === PG);
+    expect(row).toMatchObject({ expanded: false });
+    expect(closed.some((r) => r.type === 'database')).toBe(false);
+  });
+
+  it('does not ask for anything from a connection that is not up, but shows what it has', () => {
+    const { source, requested } = catalogSource('postgres', postgresServer('app_dev', null));
+    const rows = compose({
+      states: { [PG]: 'lost' },
+      expanded: { [PG]: new Set([ROOT_NODE]) },
+      sourceFor: () => source,
+    });
+    expect(requested).toEqual([]);
+    expect(rows.some((row) => row.type === 'database')).toBe(true);
+  });
+
+  it('is not tied to a folder: a connection folded away takes its explorer with it', () => {
+    const folded = MOCK_GROUPS.map((group) =>
+      group.id === 'group-local' ? { ...group, collapsed: true } : group,
+    );
+    const rows = compose({
+      groups: folded,
+      states: { [PG]: 'connected' },
+      expanded: { [PG]: new Set([ROOT_NODE]) },
+    });
+    expect(rows.some((row) => row.type === 'database')).toBe(false);
+  });
+});
+
+describe('filtering the sidebar', () => {
+  const open = {
+    expanded: {
+      [PG]: new Set([
+        ROOT_NODE,
+        nodeKeys.database('app_dev'),
+        nodeKeys.schema('app_dev', 'shop'),
+        nodeKeys.kind('app_dev', 'shop', 'table'),
+      ]),
+    },
+    states: { [PG]: 'connected' as const },
+  };
+
+  it('lists matching connections flat, then the ones that hold a matching node', () => {
+    const rows = compose({ ...open, query: 'order' });
+    const text = rows.map(describeRow);
+    // No connection is called "order": only the open one shows, with its matches' ancestors.
+    expect(text[0]).toBe('connection:local postgres');
+    expect(text).toEqual(
+      expect.arrayContaining([
+        'database:app_dev',
+        'schema:shop',
+        'kind:table',
+        'object:Order Notes',
+        'object:orders',
+      ]),
+    );
+    expect(text).not.toContain('object:products');
+    expect(rows.every((row) => row.type !== 'group')).toBe(true);
+    expect(rows[0]).toMatchObject({ type: 'connection', expanded: true });
+  });
+
+  it('shows a connection matched by name alone as a single, closed row', () => {
+    const rows = compose({ ...open, query: 'sqlite' });
+    expect(rows.map(describeRow)).toEqual(['connection:app.sqlite']);
+    expect(rows[0]).toMatchObject({ expanded: false });
+  });
+
+  it('does not touch the explorer of a connection that is not connected', () => {
+    const rows = compose({ query: 'order' });
+    expect(rows).toEqual([]);
+  });
+});
+
+describe('tree shape', () => {
+  it('derives parents and sibling positions from the levels', () => {
+    const shape = treeShape([
+      { level: 1 },
+      { level: 2 },
+      { level: 3 },
+      { level: 3 },
+      { level: 2 },
+      { level: 1 },
+    ]);
+    expect(shape.parent).toEqual([-1, 0, 1, 1, 0, -1]);
+    expect(shape.posInSet).toEqual([1, 1, 1, 2, 2, 2]);
+    expect(shape.setSize).toEqual([2, 2, 2, 2, 2, 2]);
+  });
+
+  it('handles an empty tree', () => {
+    expect(treeShape([])).toEqual({ parent: [], posInSet: [], setSize: [] });
+  });
+});
diff --git a/src/features/sidebar/sidebarRows.ts b/src/features/sidebar/sidebarRows.ts
new file mode 100644
index 0000000..4fc6839
--- /dev/null
+++ b/src/features/sidebar/sidebarRows.ts
@@ -0,0 +1,176 @@
+import type { Capabilities, Engine } from '../../ipc';
+import { buildSidebarRows, searchConnections } from '../connections/connectionRows';
+import type { ConnectionGroup, ConnectionState, ConnectionSummary } from '../connections/model';
+import {
+  buildNodes,
+  flattenNodes,
+  nodeKeys,
+  pruneNodes,
+  statusNode,
+  type ExplorerRow,
+  type MetaSource,
+} from '../explorer/explorerRows';
+
+export type SidebarTreeRow =
+  | {
+      type: 'group';
+      key: string;
+      level: number;
+      group: ConnectionGroup;
+      expandable: true;
+      expanded: boolean;
+      /** Connections in the group and its subgroups. */
+      count: number;
+    }
+  | {
+      type: 'connection';
+      key: string;
+      level: number;
+      connection: ConnectionSummary;
+      nameIndices: readonly number[];
+      state: ConnectionState;
+      expandable: true;
+      expanded: boolean;
+    }
+  | ExplorerRow;
+
+export interface SidebarInput {
+  connections: readonly ConnectionSummary[];
+  groups: readonly ConnectionGroup[];
+  query: string;
+  capabilities: ReadonlyMap<Engine, Capabilities>;
+  stateOf: (connectionId: string) => ConnectionState;
+  /** Expanded nodes of each connection. */
+  expanded: Readonly<Record<string, ReadonlySet<string>>>;
+  showSystem: boolean;
+  /** Where the tree of a connection reads its data. */
+  sourceFor: (connectionId: string) => MetaSource;
+}
+
+const NO_NODES: ReadonlySet<string> = new Set();
+
+/** The rows under a connection row: its explorer tree, shown as far as it is open. */
+function explorerRows(
+  input: SidebarInput,
+  connection: ConnectionSummary,
+  level: number,
+  state: ConnectionState,
+  filter: string,
+): ExplorerRow[] {
+  const capabilities = input.capabilities.get(connection.engine);
+  const expanded = input.expanded[connection.id] ?? NO_NODES;
+  const open = expanded.has(nodeKeys.root);
+  if (!capabilities || state === 'disconnected') return [];
+  if (filter === '' && !open) return [];
+  const options = { connectionId: connection.id, level };
+  if (state === 'connecting' && filter === '') {
+    const connecting = statusNode(nodeKeys.root, 'loading', 'connecting', { level: 'connection' });
+    return flattenNodes([connecting], { ...options, expanded, open: false });
+  }
+  const context = {
+    levels: { databases: capabilities.multipleDatabases, schemas: capabilities.schemas },
+    showSystem: input.showSystem,
+    expanded,
+    source: input.sourceFor(connection.id),
+  };
+  // Only a connection that is up loads anything: the rest shows what it already holds.
+  const fetching = state === 'connected' && open;
+  if (filter === '') {
+    const nodes = buildNodes({ ...context, exhaustive: false }, fetching);
+    return flattenNodes(nodes, { ...options, expanded, open: false });
+  }
+  const nodes = pruneNodes(buildNodes({ ...context, exhaustive: true }, fetching), filter);
+  return flattenNodes(nodes, { ...options, expanded, open: true });
+}
+
+/**
+ * The flat rows of the sidebar: connection folders and connections, and under each open
+ * connection its explorer tree. While filtering, connections that match by name come first, then
+ * the ones that only hold a matching loaded node, each with its matches and their ancestors.
+ */
+export function composeSidebarRows(input: SidebarInput): SidebarTreeRow[] {
+  const filter = input.query.trim();
+  const rows: SidebarTreeRow[] = [];
+
+  const pushConnection = (
+    connection: ConnectionSummary,
+    nameIndices: readonly number[],
+    level: number,
+    keepAlone: boolean,
+  ) => {
+    const state = input.stateOf(connection.id);
+    const children = explorerRows(input, connection, level + 1, state, filter);
+    if (!keepAlone && children.length === 0) return;
+    const open = input.expanded[connection.id]?.has(nodeKeys.root) ?? false;
+    rows.push({
+      type: 'connection',
+      key: `connection:${connection.id}`,
+      level,
+      connection,
+      nameIndices,
+      state,
+      expandable: true,
+      expanded: filter === '' ? open && state !== 'disconnected' : children.length > 0,
+    });
+    rows.push(...children);
+  };
+
+  if (filter !== '') {
+    const matches = searchConnections(input.connections, filter);
+    const named = new Set(matches.map((match) => match.connection.id));
+    for (const match of matches) pushConnection(match.connection, match.nameIndices, 1, true);
+    const others = input.connections
+      .filter((connection) => !named.has(connection.id))
+      .sort((a, b) => a.name.localeCompare(b.name));
+    for (const connection of others) pushConnection(connection, [], 1, false);
+    return rows;
+  }
+
+  for (const row of buildSidebarRows(input.connections, input.groups, '')) {
+    if (row.kind === 'group') {
+      rows.push({
+        type: 'group',
+        key: `group:${row.group.id}`,
+        level: row.depth + 1,
+        group: row.group,
+        expandable: true,
+        expanded: row.expanded,
+        count: row.count,
+      });
+    } else {
+      pushConnection(row.connection, row.nameIndices, row.depth + 1, true);
+    }
+  }
+  return rows;
+}
+
+export interface TreeShape {
+  /** Index of the parent row, `-1` at the top. */
+  parent: number[];
+  /** 1-based position among the siblings, for `aria-posinset`. */
+  posInSet: number[];
+  /** Number of siblings, for `aria-setsize`. */
+  setSize: number[];
+}
+
+/** Parents and sibling positions, which a virtualized tree must state itself (ARIA). */
+export function treeShape(rows: readonly { level: number }[]): TreeShape {
+  const parent: number[] = [];
+  const posInSet: number[] = [];
+  const setSize: number[] = [];
+  const stack: number[] = [];
+  const counts = new Map<number, number>();
+  rows.forEach((row, index) => {
+    while (stack.length >= row.level) stack.pop();
+    const up = stack.at(-1) ?? -1;
+    parent.push(up);
+    const position = (counts.get(up) ?? 0) + 1;
+    counts.set(up, position);
+    posInSet.push(position);
+    stack.push(index);
+  });
+  rows.forEach((_, index) => {
+    setSize.push(counts.get(parent[index] ?? -1) ?? 1);
+  });
+  return { parent, posInSet, setSize };
+}
diff --git a/src/features/sidebar/useRowHeight.ts b/src/features/sidebar/useRowHeight.ts
new file mode 100644
index 0000000..c3d9ba8
--- /dev/null
+++ b/src/features/sidebar/useRowHeight.ts
@@ -0,0 +1,43 @@
+import { useSyncExternalStore } from 'react';
+
+const FALLBACK_PX = 28;
+
+function readHeight(): number {
+  const value = parseFloat(
+    getComputedStyle(document.documentElement).getPropertyValue('--row-height'),
+  );
+  return Number.isFinite(value) && value > 0 ? value : FALLBACK_PX;
+}
+
+// Read once and cached: `getComputedStyle` forces a style recalculation. Only the density and
+// the theme change it.
+let cached: number | null = null;
+const listeners = new Set<() => void>();
+let observer: MutationObserver | null = null;
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  if (!observer && typeof MutationObserver !== 'undefined') {
+    observer = new MutationObserver(() => {
+      cached = null;
+      for (const notify of listeners) notify();
+    });
+    observer.observe(document.documentElement, {
+      attributes: true,
+      attributeFilter: ['data-density', 'data-theme'],
+    });
+  }
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+function snapshot(): number {
+  cached ??= readHeight();
+  return cached;
+}
+
+/** `--row-height` in px; follows the comfortable / compact density switch and the theme. */
+export function useRowHeight(): number {
+  return useSyncExternalStore(subscribe, snapshot);
+}
